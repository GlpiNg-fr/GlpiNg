<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpiNg.Modules.Cron</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BackgroundService/IHostedService (Microsoft.Extensions.Hosting.Abstractions) et
         IServiceScopeFactory font partie du shared framework ASP.NET Core, comme dans
         GlpiNg.Modules.Inventory : ce module n'a pas besoin d'une référence NuGet dédiée. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Uniquement les abstractions EF Core (DbContext, DbSet<T>) : ce module ne connaît
         pas le fournisseur de base de données ni le DbContext concret de l'hôte — voir
         GlpiNg.Modules.Inventory.csproj pour le même principe. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlpiNg.Modules.Abstractions\GlpiNg.Modules.Abstractions.csproj" />
  </ItemGroup>
</Project>
