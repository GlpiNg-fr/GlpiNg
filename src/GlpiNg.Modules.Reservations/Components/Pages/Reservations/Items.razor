@page "/tools/reservations/items"
@rendermode InteractiveServer

<PageTitle>@T("Éléments réservables — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list align-items-center">
            <a class="btn" href="/tools/reservations">
                <i class="ti ti-chevron-left me-1"></i>@T("Planning")
            </a>
            <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                <input type="text" class="form-control" placeholder="@(T("Rechercher..."))"
                       @bind="_searchTerm" @bind:event="oninput" />
            </div>
        </div>

        <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
            <i class="ti ti-refresh"></i>
        </button>
    </div>

    <div class="card-body border-bottom">
        <p class="hint mb-0">
            @T("Un objet devient réservable depuis sa propre fiche, onglet « Réservations » : cette page ne fait que lister les autorisations existantes, les suspendre et les retirer.")
        </p>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>@T("Élément")</th>
                    <th>@T("Type")</th>
                    <th>@T("Consigne")</th>
                    <th>@T("Réservations")</th>
                    <th>@T("Réservable")</th>
                    <th style="width: 4rem;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Filtered.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">@T("Aucun élément réservable.")</td></tr>
                }
                else
                {
                    @foreach (ReservableItem item in Filtered)
                    {
                        <tr>
                            <td>
                                @if (item.ItemUrl is { Length: > 0 } url)
                                {
                                    <a href="@url" class="text-reset fw-semibold">@item.ItemName</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@item.ItemName</span>
                                }
                            </td>
                            <td class="text-secondary">@item.ItemType</td>
                            <td>
                                <input class="form-control form-control-sm" value="@item.Comment"
                                       @onchange="@((ChangeEventArgs e) => SaveCommentAsync(item, e.Value as string))" />
                            </td>
                            <td class="text-secondary">@_counts.GetValueOrDefault(item.Id)</td>
                            <td>
                                <label class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" checked="@item.IsActive"
                                           @onchange="@((ChangeEventArgs e) => ToggleAsync(item, (bool)(e.Value ?? false)))" />
                                </label>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn btn-icon btn-sm text-danger"
                                            data-bs-toggle="dropdown" aria-expanded="false"
                                            title="@(T("Retirer l'autorisation"))">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 280px;">
                                        <p class="mb-2">
                                            @T("Retirer l'autorisation supprime aussi ses {0} réservation(s). Cette action est définitive.",
                                                _counts.GetValueOrDefault(item.Id))
                                        </p>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    @onclick="() => RemoveAsync(item)">
                                                @T("Retirer")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>
