@page "/tools/reservations"
@rendermode InteractiveServer

<PageTitle>@T("Réservations — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="() => ShiftMonth(-1)" title="@(T("Mois précédent"))">
                <i class="ti ti-chevron-left"></i>
            </button>
            <span class="fw-semibold text-capitalize">@MonthLabel</span>
            <button type="button" class="btn btn-icon" @onclick="() => ShiftMonth(1)" title="@(T("Mois suivant"))">
                <i class="ti ti-chevron-right"></i>
            </button>
            <button type="button" class="btn" @onclick="GoToday">@T("Aujourd'hui")</button>
        </div>

        <div class="btn-list align-items-center">
            <a class="btn" href="/tools/reservations/items">
                <i class="ti ti-list-check me-1"></i>@T("Éléments réservables")
            </a>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" disabled="@(_reservableItems.Count == 0)"
                    @onclick="() => OpenNew(null)">
                <i class="ti ti-plus me-1"></i>@T("Réserver")
            </button>
        </div>
    </div>

    @if (_reservableItems.Count == 0)
    {
        <div class="card-body">
            <div class="glping-config-placeholder">
                <i class="ti ti-calendar-off"></i>
                <p class="mb-0">@T("Aucun élément réservable.")</p>
                <p class="hint mb-0">
                    @T("Un objet du parc devient réservable depuis sa propre fiche, onglet « Réservations ».")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-vcenter card-table glping-reservation-calendar">
                <thead>
                    <tr>
                        @foreach (string day in DayHeaders)
                        {
                            <th class="text-center">@day</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (DateTime weekStart in Weeks)
                    {
                        <tr>
                            @for (int offset = 0; offset < 7; offset++)
                            {
                                DateTime day = weekStart.AddDays(offset);
                                bool inMonth = day.Month == _month.Month;

                                <td class="align-top @(inMonth ? string.Empty : "text-secondary bg-body-tertiary")"
                                    style="min-width: 8rem; height: 6rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="@(day.Date == DateTime.Today ? "badge bg-primary" : string.Empty)">
                                            @day.Day
                                        </span>
                                        @if (inMonth)
                                        {
                                            <button type="button" class="btn btn-icon btn-sm"
                                                    title="@(T("Réserver ce jour"))" @onclick="() => OpenNew(day)">
                                                <i class="ti ti-plus"></i>
                                            </button>
                                        }
                                    </div>

                                    @foreach (Reservation reservation in OnDay(day))
                                    {
                                        <div class="small text-truncate" title="@Tooltip(reservation)">
                                            <i class="ti ti-point-filled text-primary"></i>
                                            <span class="fw-semibold">@reservation.Begin.ToString("HH:mm")</span>
                                            @(" ")@(reservation.ReservableItem?.ItemName)
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-clock-hour-4 me-2"></i>@T("Réservations à venir")</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>@T("Élément")</th>
                    <th>@T("Du")</th>
                    <th>@T("Au")</th>
                    <th>@T("Par")</th>
                    <th>@T("Commentaire")</th>
                    <th style="width: 6rem;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_upcoming.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">@T("Aucune réservation à venir.")</td></tr>
                }
                else
                {
                    @foreach (Reservation reservation in _upcoming)
                    {
                        <tr>
                            <td>
                                @if (reservation.ReservableItem?.ItemUrl is { Length: > 0 } url)
                                {
                                    <a href="@url" class="text-reset fw-semibold">@reservation.ReservableItem.ItemName</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@reservation.ReservableItem?.ItemName</span>
                                }
                                @if (reservation.SeriesId is not null)
                                {
                                    <span class="badge bg-azure-lt ms-2">@T("Série")</span>
                                }
                            </td>
                            @* Heures murales : LocalDateTime, jamais DateTime — voir Reservation. *@
                            <td class="text-secondary">@Display.LocalDateTime(reservation.Begin)</td>
                            <td class="text-secondary">@Display.LocalDateTime(reservation.End)</td>
                            <td class="text-secondary">@reservation.UserName</td>
                            <td class="text-secondary">@reservation.Comment</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-icon btn-sm text-danger"
                                        title="@(T("Annuler cette réservation"))"
                                        @onclick="() => CancelAsync(reservation.Id, false)">
                                    <i class="ti ti-trash"></i>
                                </button>
                                @if (reservation.SeriesId is not null)
                                {
                                    <button type="button" class="btn btn-icon btn-sm text-danger"
                                            title="@(T("Annuler toute la série"))"
                                            @onclick="() => CancelAsync(reservation.Id, true)">
                                        <i class="ti ti-trash-x"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newReservationModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-calendar-plus me-2"></i>@T("Nouvelle réservation")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                @if (_error is { Length: > 0 })
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <div class="glping-fiche-field">
                    <label>@T("Élément")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                    <select class="form-select" @bind="_newItemId">
                        @foreach (ReservableItem item in _reservableItems)
                        {
                            <option value="@item.Id">@item.ItemName (@item.ItemType)</option>
                        }
                    </select>
                    @if (SelectedItemComment is { Length: > 0 } comment)
                    {
                        <p class="hint">@comment</p>
                    }
                </div>

                <div class="row">
                    <div class="col-md-6 glping-fiche-field">
                        <label>@T("Début")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                        <input type="datetime-local" class="form-control" @bind="_newBegin" />
                    </div>
                    <div class="col-md-6 glping-fiche-field">
                        <label>@T("Fin")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                        <input type="datetime-local" class="form-control" @bind="_newEnd" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 glping-fiche-field">
                        <label>@T("Répéter")</label>
                        <select class="form-select" @bind="_newRepeat">
                            <option value="@ReservationRepeat.None">@T("Pas de répétition")</option>
                            <option value="@ReservationRepeat.Daily">@T("Chaque jour")</option>
                            <option value="@ReservationRepeat.Weekly">@T("Chaque semaine")</option>
                            <option value="@ReservationRepeat.Monthly">@T("Chaque mois")</option>
                        </select>
                    </div>
                    <div class="col-md-6 glping-fiche-field">
                        <label>@T("Occurrences")</label>
                        <input type="number" class="form-control" min="1" max="@ReservationService.MaxOccurrences"
                               disabled="@(_newRepeat == ReservationRepeat.None)" @bind="_newOccurrences" />
                        <p class="hint">@T("Un chevauchement sur une seule occurrence refuse toute la série.")</p>
                    </div>
                </div>

                <div class="glping-fiche-field">
                    <label>@T("Commentaire")</label>
                    <textarea class="form-control" rows="2" @bind="_newComment"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>@T("Réserver")
                </button>
            </div>
        </div>
    </div>
</div>
