<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpiNg.Modules.Reservations</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Types ASP.NET Core (composants Razor, AuthenticationStateProvider) sans dépendre de l'hôte. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Abstractions EF Core seules : ce module ne connaît ni le fournisseur ni le DbContext concret
      (voir le commentaire de GlpiNg.Modules.Inventory.csproj).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- ToastService (confirmations/erreurs de formulaire), comme les pages des autres modules. -->
    <PackageReference Include="Blazor.Bootstrap" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Contrats seuls : une réservation ne connaît aucun objet du parc. Elle désigne ce qu'elle
      réserve par un couple ItemType/ItemId, exactement comme un document ou une note — c'est ce
      qui permet de réserver un ordinateur, un moniteur ou un actif personnalisé sans que ce
      module dépende d'Inventory ni de l'hôte.
    -->
    <ProjectReference Include="..\GlpiNg.Modules.Abstractions\GlpiNg.Modules.Abstractions.csproj" />
  </ItemGroup>

</Project>
