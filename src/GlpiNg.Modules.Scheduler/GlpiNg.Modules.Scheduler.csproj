<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpiNg.Modules.Scheduler</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ICronTask/ILogger/IServiceCollection font partie du shared framework ASP.NET Core,
         comme dans GlpiNg.Modules.Cron : ce module n'a pas besoin d'une référence NuGet dédiée. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Uniquement les abstractions EF Core (DbContext, DbSet<T>) : ce module ne connaît pas
         le fournisseur de base de données ni le DbContext concret de l'hôte — même principe que
         GlpiNg.Modules.Cron.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Référence Deployment directement (comme Deployment référence Inventory) : ce module
         évalue et lance des DeploymentTask via DeploymentTaskLaunchService, pas de simples
         clés étrangères. -->
    <ProjectReference Include="..\GlpiNg.Modules.Abstractions\GlpiNg.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\GlpiNg.Modules.Deployment\GlpiNg.Modules.Deployment.csproj" />
  </ItemGroup>
</Project>
