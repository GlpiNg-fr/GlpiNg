<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GlpiNg.Web</RootNamespace>
    <UserSecretsId>glpi-ng-web-secrets</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 : commentaire XML manquant sur un membre public — pas pertinent ici,
         seuls les commentaires déjà présents sur les contrôleurs sont exploités par Swagger. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.Bootstrap" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.10" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="AnthoDingo.Setup" Version="2.0.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.11" />
    <!-- Envoi SMTP réel des notifications (voir Services/Notifications/SmtpMailSender.cs) :
         System.Net.Mail.SmtpClient est déconseillé par Microsoft pour du code neuf
         (STARTTLS/TLS peu fiable), MailKit est le remplacement standard de l'écosystème .NET. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlpiNg.Modules.Inventory\GlpiNg.Modules.Inventory.csproj" />
    <ProjectReference Include="..\GlpiNg.Modules.Abstractions\GlpiNg.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\GlpiNg.Modules.Cron\GlpiNg.Modules.Cron.csproj" />
    <ProjectReference Include="..\GlpiNg.Modules.Deployment\GlpiNg.Modules.Deployment.csproj" />
  </ItemGroup>

</Project>
