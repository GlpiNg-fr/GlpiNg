@using GlpiNg.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection
@inject GlpiNg.Web.Services.Plugins.PluginRegistry Plugins
@implements IDisposable

<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="AdditionalAssemblies">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@T("Page introuvable — GlpiNg")</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p>@T("Désolé, cette page n'existe pas.")</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private IEnumerable<Assembly> AdditionalAssemblies =>
    [
        typeof(GlpiNg.Modules.Inventory.InventoryModuleServiceCollectionExtensions).Assembly,
        typeof(GlpiNg.Modules.Deployment.DeploymentModuleServiceCollectionExtensions).Assembly,
        typeof(GlpiNg.Modules.KnowledgeBase.KnowledgeBaseModuleServiceCollectionExtensions).Assembly,
        typeof(GlpiNg.Modules.Management.ManagementModuleServiceCollectionExtensions).Assembly,
        typeof(GlpiNg.Modules.Assistance.AssistanceModuleServiceCollectionExtensions).Assembly,
        .. Plugins.Assemblies,
    ];

    // Un plugin chargé ou déchargé à chaud : le Router reçoit la nouvelle liste et reconstruit sa
    // table de routes. La page en cours est re-routée — celle d'un plugin retiré retombe sur la page
    // attrape-tout (PluginFallback), sans fermer le circuit.
    protected override void OnInitialized() => Plugins.Changed += OnPluginsChanged;

    private void OnPluginsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Plugins.Changed -= OnPluginsChanged;
}
