@using GlpiNg.Web.Components.Layout
<!DOCTYPE html>
@* Thème de l'utilisateur (préférences « Palette de couleur » et « Contraste élevé ») : les
   palettes sont définies dans glping-theme.css sous ces attributs, et data-bs-theme bascule Tabler en
   mode sombre pour Darker et Midnight. Rendu côté serveur, donc sans flash au chargement. *@
<html lang="@Display.Values.Language[..2]" data-glping-theme="@Display.Values.Palette" data-bs-theme="@(Display.Values.IsDarkPalette ? "dark" : "light")"
      data-glping-contrast="@(Display.Values.HighContrast ? "" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GlpiNg</title>
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="@Assets["css/glping-theme.css"]" />
    <link rel="stylesheet" href="_content/Blazor.Bootstrap/blazor.bootstrap.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <!--
        Uniquement le bundle Bootstrap "officiel" ici, pas le JS de @@tabler/core (qui embarque
        sa propre copie interne des composants Bootstrap, dont Dropdown) : les deux enregistraient
        chacun leur propre gestionnaire de clic délégué sur document pour [data-bs-toggle="dropdown"],
        et s'entre-perturbaient — le clic ouvrait le menu via Bootstrap CDN, puis la copie de Tabler,
        lisant le DOM déjà modifié, le croyait "déjà ouvert" et le refermait aussitôt (même clic,
        même passage synchrone). Seul le CSS de Tabler est nécessaire (voir <link> ci-dessus) ; son
        JS est redondant avec bootstrap.bundle.min.js, dont BlazorBootstrap (ToastService, etc.) a
        justement besoin comme unique source du global window.bootstrap.
    -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Assets["js/glping.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>
</body>
</html>
