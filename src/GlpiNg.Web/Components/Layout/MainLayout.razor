@inherits LayoutComponentBase

<div class="glpi-app">
    <aside class="glpi-sidebar">
        <a href="/" class="glpi-brand">
            <i class="ti ti-server-2"></i>
            <span>GlpiNg</span>
        </a>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
                <i class="ti ti-layout-dashboard"></i>
                <span>Tableau de bord</span>
            </NavLink>
            <NavLink href="/computers" class="nav-link">
                <i class="ti ti-device-desktop"></i>
                <span>Ordinateurs</span>
            </NavLink>
            <NavLink href="/agents" class="nav-link">
                <i class="ti ti-cpu"></i>
                <span>Agents</span>
            </NavLink>
            <NavLink href="/deployments" class="nav-link">
                <i class="ti ti-package"></i>
                <span>Déploiements</span>
            </NavLink>
        </nav>
    </aside>

    <div class="glpi-content">
        <header class="glpi-topbar">
            <div class="input-icon glpi-search">
                <span class="input-icon-addon">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Rechercher..." />
            </div>
        </header>

        <main class="glpi-page-body">
            @Body
        </main>
    </div>
</div>
