@inherits LayoutComponentBase

@* « Afficher les compteurs » (préférences) : une classe ici masque ceux de tous les onglets de fiche. *@
<div class="glpi-app @(Display.ShowTabCounters ? "" : "glpi-hide-tab-counts")">
    <aside class="glpi-sidebar @(_collapsed ? "collapsed" : "")">
        <a href="/" class="glpi-brand">
            <i class="ti ti-server-2"></i>
            <span>GlpiNg</span>
        </a>

        @if (_searchOpen)
        {
            <div class="glpi-menu-search open">
                <i class="ti ti-search"></i>
                <input type="text" placeholder="Chercher dans le menu"
                       value="@_searchTerm" @oninput="OnSearchInput" />
                <button type="button" class="glpi-menu-search-close" @onclick="ToggleSearch">
                    <i class="ti ti-x"></i>
                </button>
            </div>
        }
        else
        {
            <button type="button" class="glpi-menu-search" @onclick="ToggleSearch">
                <i class="ti ti-arrow-right"></i>
                <span>Chercher dans le menu</span>
            </button>
        }

        <nav class="glpi-nav">
            @foreach (var group in Groups)
            {
                if (!GroupMatches(group))
                {
                    continue;
                }

                var isOpen = IsGroupOpen(group);
                <div class="glpi-nav-group @(isOpen ? "open" : "")">
                    <button type="button" class="glpi-nav-group-toggle" @onclick="() => ToggleGroup(group.Key)">
                        <i class="ti @group.Icon"></i>
                        <span>@group.Label</span>
                        <i class="ti ti-chevron-down glpi-chevron"></i>
                    </button>
                    @if (isOpen)
                    {
                        <div class="glpi-nav-group-items">
                            @foreach (var item in FilteredItems(group))
                            {
                                if (item.Href is not null)
                                {
                                    <NavLink href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="glpi-nav-subitem">
                                        <i class="ti @(item.Icon ?? "ti-point")"></i>
                                        <span>@item.Label</span>
                                    </NavLink>
                                }
                                else
                                {
                                    <span class="glpi-nav-subitem disabled" title="Pas encore disponible">
                                        <i class="ti @(item.Icon ?? "ti-point")"></i>
                                        <span>@item.Label</span>
                                    </span>
                                }
                            }
                        </div>
                    }
                    <div class="glpi-nav-flyout">
                        <div class="glpi-nav-flyout-panel">
                            <div class="glpi-nav-flyout-header">@group.Label</div>
                            <div class="glpi-nav-flyout-items">
                                @foreach (var item in FilteredItems(group))
                                {
                                    if (item.Href is not null)
                                    {
                                        <NavLink href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="glpi-nav-subitem">
                                            <i class="ti @(item.Icon ?? "ti-point")"></i>
                                            <span>@item.Label</span>
                                        </NavLink>
                                    }
                                    else
                                    {
                                        <span class="glpi-nav-subitem disabled" title="Pas encore disponible">
                                            <i class="ti @(item.Icon ?? "ti-point")"></i>
                                            <span>@item.Label</span>
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </nav>

        <button type="button" class="glpi-sidebar-collapse" @onclick="ToggleSidebarCollapse">
            <i class="ti @(_collapsed ? "ti-chevrons-right" : "ti-chevrons-left")"></i>
            @if (!_collapsed)
            {
                <span>Réduire le menu</span>
            }
        </button>
    </aside>

    <div class="glpi-content">
        <header class="glpi-topbar">
            <nav class="glpi-breadcrumb">
                @for (int i = 0; i < Breadcrumb.Count; i++)
                {
                    var crumb = Breadcrumb[i];
                    if (i > 0)
                    {
                        <span class="glpi-breadcrumb-sep">/</span>
                    }
                    @* Cliquable dès qu'il mène ailleurs que là où l'on est : c'est la destination
                       qui décide, pas la position dans le fil. *@
                    if (crumb.Href is null || IsCurrentPage(crumb.Href))
                    {
                        <span class="glpi-breadcrumb-item active">
                            <i class="ti @crumb.Icon"></i>
                            <span>@crumb.Label</span>
                        </span>
                    }
                    else
                    {
                        <a href="@crumb.Href" class="glpi-breadcrumb-item">
                            <i class="ti @crumb.Icon"></i>
                            <span>@crumb.Label</span>
                        </a>
                    }
                }
            </nav>

            <div class="input-icon glpi-search">
                <span class="input-icon-addon">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Rechercher..." />
            </div>

            <EntitySelector />

            <div class="glpi-topbar-user dropdown">
                <a href="#" class="glpi-user-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="glpi-user-info">
                        <span class="glpi-user-name">@_userName</span>
                    </span>
                    <span class="glpi-avatar">@_userInitial</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/mon-profil"><i class="ti ti-user"></i> Mon profil</a></li>
                    <li><a class="dropdown-item" href="/preferences"><i class="ti ti-settings"></i> Préférences</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form method="post" action="/Account/Logout">
                            <AntiforgeryToken />
                            <button type="submit" class="dropdown-item glpi-logout-button"><i class="ti ti-logout"></i> Se déconnecter</button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main class="glpi-page-body">
            @* Droits par profil : pendant, côté circuit Blazor, du SectionAccessMiddleware, qui ne
               voit passer que les entrées par l'URL. Sans ça, un lien interne mènerait quand même
               à la page. *@
            @* Renvoi du SectionAccessMiddleware après un accès direct refusé : sans ce message,
               l'utilisateur se retrouverait sur le tableau de bord sans explication. *@
            @if (DeniedSection is { } denied)
            {
                <div class="alert alert-warning alert-dismissible" role="alert">
                    <i class="ti ti-lock"></i>
                    Accès refusé à la section « @denied » : votre profil ne l'autorise pas pour l'entité active.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            }

            @if (!CanViewCurrentPage)
            {
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-title"><i class="ti ti-lock"></i> Droits insuffisants</h4>
                    <p class="mb-0">
                        Votre profil ne donne pas accès à la section « @CurrentSection » pour l'entité active.
                        Changez d'entité active depuis le bandeau, ou demandez une habilitation à un administrateur.
                    </p>
                </div>
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

<Toasts class="p-3" Placement="ToastsPlacement.TopRight" AutoHide="true" Delay="5000" />
