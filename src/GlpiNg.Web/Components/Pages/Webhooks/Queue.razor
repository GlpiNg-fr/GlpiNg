@page "/config/webhooks/queue"
@using GlpiNg.Web.Models.Webhooks
@rendermode InteractiveServer

<PageTitle>File d'attente des webhooks — GlpiNg</PageTitle>

<WebhooksTabStrip Current="queue" />

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <span class="fw-semibold">@_items.Count livraison(s)</span>
        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>
            <button type="button" class="btn btn-outline-danger" disabled="@(SentOrFailedCount == 0)" @onclick="PurgeSentAndFailedAsync">
                <i class="ti ti-trash me-1"></i>Purger envoyés/échoués
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Webhook</th>
                    <th>Événement</th>
                    <th>Créé le</th>
                    <th>Cible</th>
                    <th>Statut</th>
                    <th>Réponse</th>
                    <th>Tentatives</th>
                    <th style="width: 10rem;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">La file d'attente est vide.</td>
                    </tr>
                }
                else
                {
                    @foreach (QueuedWebhook item in _items)
                    {
                        <tr>
                            <td>@item.WebhookName</td>
                            <td class="text-secondary">@EventLabel(item)</td>
                            <td class="text-nowrap">@Display.DateTime(item.CreatedAt)</td>
                            <td class="text-secondary" style="word-break: break-all;">
                                <span class="badge bg-secondary-lt me-1">@item.Method.ToString().ToUpperInvariant()</span>@item.Url
                            </td>
                            <td>
                                <span class="badge @StatusBadgeClass(item.Status)">@StatusLabel(item.Status)</span>
                                @if (!string.IsNullOrEmpty(item.LastError))
                                {
                                    <div class="text-danger small">@item.LastError</div>
                                }
                            </td>
                            <td>@(item.ResponseStatusCode?.ToString() ?? "—")</td>
                            <td>@item.Attempts</td>
                            <td>
                                <div class="btn-list">
                                    <button type="button" class="btn btn-icon btn-sm" title="Voir le détail"
                                            @onclick="() => Inspect(item)">
                                        <i class="ti ti-eye"></i>
                                    </button>
                                    @if (item.Status == QueuedWebhookStatus.Failed)
                                    {
                                        <button type="button" class="btn btn-icon btn-sm" title="Remettre en file"
                                                @onclick="() => RetryAsync(item.Id)">
                                            <i class="ti ti-reload"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Supprimer"
                                            @onclick="() => DeleteAsync(item.Id)">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

@if (_inspected is { } inspected)
{
    <div class="card mt-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">
                <i class="ti ti-eye me-2"></i>Livraison #@inspected.Id — @inspected.WebhookName
            </span>
            <button type="button" class="btn btn-icon btn-sm" title="Fermer" @onclick="() => _inspected = null">
                <i class="ti ti-x"></i>
            </button>
        </div>
        <div class="card-body">
            <div class="glping-fiche-field">
                <label>Cible</label>
                <div class="glping-fiche-value-box">@inspected.Method.ToString().ToUpperInvariant() @inspected.Url</div>
            </div>

            @if (!string.IsNullOrEmpty(inspected.HeadersJson))
            {
                <div class="glping-fiche-block-title mt-3"><i class="ti ti-list-details"></i>En-têtes supplémentaires</div>
                <pre class="small mb-0" style="white-space: pre-wrap; word-break: break-all;">@FormatHeaders(inspected.HeadersJson)</pre>
            }

            <div class="glping-fiche-block-title mt-3"><i class="ti ti-code"></i>Corps envoyé</div>
            <pre class="small mb-0" style="white-space: pre-wrap; word-break: break-all;">@(inspected.Payload ?? "(aucun corps — méthode GET)")</pre>

            @if (!string.IsNullOrEmpty(inspected.ResponseBody))
            {
                <div class="glping-fiche-block-title mt-3"><i class="ti ti-arrow-back"></i>Réponse du destinataire</div>
                <pre class="small mb-0" style="white-space: pre-wrap; word-break: break-all;">@inspected.ResponseBody</pre>
            }
            else
            {
                @* Distinguer « pas de réponse » de « on ne l'a pas gardée » : sans ça, une
                   livraison réussie sans corps affiché se lit comme un défaut. *@
                <p class="hint mt-3">
                    @(inspected.SaveResponseBody
                        ? "Le destinataire n'a rien renvoyé."
                        : "La réponse n'est pas conservée pour ce webhook (option « Conserver la réponse »).")
                </p>
            }
        </div>
    </div>
}
