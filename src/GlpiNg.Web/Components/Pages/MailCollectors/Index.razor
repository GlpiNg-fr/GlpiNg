@page "/config/mail-collectors"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>@T("Collecteurs — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>@T("Rechercher")
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="@(T("Rechercher un collecteur..."))"
                               @bind="_searchTerm" @bind:event="oninput" @bind:after="ApplyFilter" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="@(T("Supprimer la sélection"))">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">@T("Supprimer {0} collecteur(s) sélectionné(s) ? Cette action est définitive.", _selectedIds.Count)</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">@T("Annuler")</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">@T("Supprimer")</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newMailCollectorModal">
                <i class="ti ti-plus me-1"></i>@T("Ajouter")
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        <input class="form-check-input m-0" type="checkbox" title="@(T("Sélectionner les éléments visibles"))"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>@T("Nom")</th>
                    <th>@T("Serveur")</th>
                    <th>@T("Identifiant")</th>
                    <th>@T("Activé")</th>
                    <th>@T("Dernière relève")</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">@T("Aucun collecteur de courriels configuré.")</td>
                    </tr>
                }
                else
                {
                    @foreach (MailCollector collector in _filtered)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(collector.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(collector.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/config/mail-collectors/{collector.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-mail me-1 text-secondary"></i>@collector.Name
                                </a>
                            </td>
                            <td>@collector.Host@(collector.Port is { } port ? $":{port}" : "")</td>
                            <td>@collector.Login</td>
                            <td>@(collector.IsActive ? T("Oui") : T("Non"))</td>
                            <td>
                                @if (collector.LastRunAt is null)
                                {
                                    <span class="text-secondary">@T("Jamais")</span>
                                }
                                else if (collector.LastError is not null)
                                {
                                    <span class="text-danger" title="@collector.LastError">
                                        <i class="ti ti-alert-triangle me-1"></i>@Display.DateTime(collector.LastRunAt)
                                    </span>
                                }
                                else
                                {
                                    @Display.DateTime(collector.LastRunAt)
                                    <span class="text-secondary ms-1">@T("({0} message(s))", collector.LastImportedCount)</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newMailCollectorModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-mail me-2"></i>@T("Nouvel élément - Collecteur")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                <MailCollectorFormFields Collector="_new" Entities="_entities" @bind-Password="_newPassword" OnChanged="StateHasChanged" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@(!CanCreate)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
</div>
