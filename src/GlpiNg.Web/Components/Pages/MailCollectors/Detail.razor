@page "/config/mail-collectors/{CollectorId:int}"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>@(_collector?.Name ?? T("Collecteur")) — GlpiNg</PageTitle>

@if (_collector is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-mail fs-1"></i>
        <p class="mt-2">@T("Ce collecteur est introuvable.")</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <i class="ti ti-mail me-2"></i>
            <span class="fw-semibold">@T("Collecteur - {0} - ID {1}", _collector.Name, _collector.Id)</span>
        </div>
        <div class="card-body">
            @if (_collector.LastError is not null)
            {
                <div class="alert alert-danger">
                    <i class="ti ti-alert-triangle me-1"></i>
                    @T("Dernière relève en échec ({0}) : {1}", Display.DateTime(_collector.LastRunAt), _collector.LastError)
                </div>
            }
            else if (_collector.LastRunAt is not null)
            {
                <div class="alert alert-info">
                    <i class="ti ti-info-circle me-1"></i>
                    @T("Dernière relève le {0} : {1} message(s).", Display.DateTime(_collector.LastRunAt), _collector.LastImportedCount)
                </div>
            }

            <EditForm Model="_collector" OnValidSubmit="SaveAsync">
                <MailCollectorFormFields Collector="_collector" Entities="_entities" @bind-Password="_password" />

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                        <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                    </button>
                    <button type="button" class="btn btn-outline-primary" disabled="@(_isSaving || _isCollecting)" @onclick="CollectNowAsync">
                        <i class="ti ti-download me-1"></i>@(_isCollecting ? T("Relève en cours…") : T("Relever maintenant"))
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                        <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
