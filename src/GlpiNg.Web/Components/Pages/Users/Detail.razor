@page "/admin/users/{UserId:int}"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>@(_user?.UserName ?? T("Utilisateur")) — GlpiNg</PageTitle>

@if (_user is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-user-off fs-1"></i>
        <p class="mt-2">@T("Cet utilisateur est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-user"></i>
            <span>@T("Utilisateur - {0} - ID {1}", _user.UserName, _user.Id)</span>
            <button type="button" class="glping-fiche-favorite" title="@(T("Ajouter aux favoris"))">
                <i class="ti ti-star"></i>
            </button>
        </div>
        <div class="glping-fiche-toolbar">
            @if (_total > 0)
            {
                <span class="glping-fiche-pager-count">@_position/@_total</span>
                <a class="glping-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/admin/users/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glping-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/admin/users/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="glping-fiche-tab-item @(_activeTabKey == tab.Key ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                    <i class="ti @tab.Icon"></i>
                    <span>@T(tab.Label)</span>
                    @if (tab.Count is { } count)
                    {
                        <span class="glping-fiche-tab-count">@count</span>
                    }
                </button>
            }
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "utilisateur":
                    <EditForm Model="_user" OnValidSubmit="SaveAsync">
                        <UserFormFields User="_user" />

                        <div class="glping-fiche-block-title mt-2"><i class="ti ti-key"></i>@T("Mot de passe et jeton d'accès")</div>
                        @if (_showPasswordFields)
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="glping-fiche-field">
                                        <label>@T("Mot de passe")</label>
                                        <input class="form-control" type="password" @bind="_newPassword" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="glping-fiche-field">
                                        <label>@T("Confirmer")</label>
                                        <input class="form-control" type="password" @bind="_newPasswordConfirm" />
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm" @onclick="TogglePasswordFields">@T("Annuler")</button>
                        }
                        else
                        {
                            <div class="glping-fiche-field">
                                <label>@T("Mot de passe")</label>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="TogglePasswordFields">
                                    <i class="ti ti-lock me-1"></i>@T("Modifier le mot de passe")
                                </button>
                            </div>
                        }

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "groupes":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-users"></i>@T("Groupes ({0})", _user.GroupMemberships.Count)</div>
                        @if (_user.GroupMemberships.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-users"></i>
                                <p class="mb-0">@T("Cet utilisateur n'appartient à aucun groupe.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Groupe")</th>
                                            <th style="width: 6rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiGroupUser membership in _user.GroupMemberships.OrderBy(m => m.Group?.Name ?? string.Empty))
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/admin/groups/{membership.GroupId}")" class="text-reset">
                                                        <i class="ti ti-users me-1 text-secondary"></i>@(membership.Group?.Name ?? T("Groupe inconnu"))
                                                    </a>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Retirer"))" @onclick="() => RemoveGroupAsync(membership.GroupId)">
                                                        <i class="ti ti-x"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <div class="d-flex gap-2 mt-3">
                            <select class="form-select" style="max-width: 320px;" @bind="_groupIdToAdd">
                                <option value="0">@T("-- Choisir un groupe --")</option>
                                @foreach (GlpiGroup group in AvailableGroups())
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary" disabled="@(_groupIdToAdd == 0)" @onclick="AddGroupAsync">
                                <i class="ti ti-plus me-1"></i>@T("Ajouter")
                            </button>
                        </div>
                    </div>
                    break;

                case "habilitations":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-plus"></i>@T("Ajouter une habilitation")</div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0">
                                <thead>
                                    <tr>
                                        <th>@T("Entité")</th>
                                        <th>@T("Profil")</th>
                                        <th>@T("Récursif")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <select class="form-select" @bind="_habEntityIdToAdd">
                                                <option value="0">@T("-- Choisir --")</option>
                                                @foreach (GlpiEntity entity in _allEntities.OrderBy(EntityFullName))
                                                {
                                                    <option value="@entity.Id">@EntityFullName(entity)</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select" @bind="_habProfileIdToAdd">
                                                <option value="0">@T("-- Choisir --")</option>
                                                @foreach (GlpiProfile profile in _allProfiles)
                                                {
                                                    <option value="@profile.Id">@profile.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select" value="@(_habIsRecursiveToAdd ? "true" : "false")" @onchange="@(e => _habIsRecursiveToAdd = e.Value?.ToString() == "true")">
                                                <option value="false">@T("Non")</option>
                                                <option value="true">@T("Oui")</option>
                                            </select>
                                        </td>
                                        <td style="width: 8rem;">
                                            <button type="button" class="btn btn-primary w-100" disabled="@(_habEntityIdToAdd == 0 || _habProfileIdToAdd == 0)" @onclick="AddHabilitationAsync">
                                                <i class="ti ti-plus me-1"></i>@T("Ajouter")
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="glping-fiche-block-title mt-3"><i class="ti ti-key"></i>@T("Habilitations ({0})", _userHabilitations.Count)</div>
                        @if (_userHabilitations.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-key"></i>
                                <p class="mb-0">@T("Aucune habilitation.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Entité")</th>
                                            <th>@T("Profil")</th>
                                            <th>@T("Récursif")</th>
                                            <th style="width: 6rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiUserProfile h in _userHabilitations)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/admin/entities/{h.EntityId}")" class="text-reset">
                                                        <i class="ti ti-sitemap me-1 text-secondary"></i>@(h.Entity is not null ? EntityFullName(h.Entity) : T("Entité inconnue"))
                                                    </a>
                                                </td>
                                                <td>
                                                    <a href="@($"/admin/profiles/{h.ProfileId}")" class="text-reset">@(h.Profile?.Name ?? T("Profil inconnu"))</a>
                                                </td>
                                                <td>@(h.IsRecursive ? T("Oui") : T("Non"))</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Retirer"))" @onclick="() => RemoveHabilitationAsync(h.Id)">
                                                        <i class="ti ti-x"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "preferences":
                    <EditForm Model="_user" OnValidSubmit="SaveAsync">
                        <div class="glping-fiche-block-title"><i class="ti ti-adjustments"></i>@T("Personnalisation")</div>
                        <p class="text-secondary small">@T("Les préférences d'affichage (langue, palette, format des dates...) se règlent par chaque utilisateur depuis sa page Préférences : seul le repli du menu latéral se modifie ici.")</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Réduire le menu latéral")</label>
                                    <select class="form-select" value="@(_user.SidebarCollapsed ? "true" : "false")" @onchange="@(e => _user.SidebarCollapsed = e.Value?.ToString() == "true")">
                                        <option value="false">@T("Non")</option>
                                        <option value="true">@T("Oui")</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "securite":
                    <EditForm Model="_user" OnValidSubmit="SaveAsync">
                        <div class="glping-fiche-block-title"><i class="ti ti-shield"></i>@T("Double authentification (2FA)")</div>
                        <p class="text-secondary small">@T("Si la double authentification est imposée par l'entité ou un groupe de cet utilisateur, cette dérogation individuelle permet de désactiver l'obligation.")</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Désactiver l'obligation du 2FA")</label>
                                    <select class="form-select" value="@(_user.TwoFactorAuthDisabled ? "true" : "false")" @onchange="@(e => _user.TwoFactorAuthDisabled = e.Value?.ToString() == "true")">
                                        <option value="false">@T("Non")</option>
                                        <option value="true">@T("Oui")</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "synchronisation":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-refresh"></i>@T("Source d'authentification")</div>
                        <p class="mb-1"><strong>@T("Source :")</strong> @(_user.AuthSource == UserAuthSource.Ldap ? T("Annuaire LDAP") : T("Locale (base GlpiNg)"))</p>
                        @if (_user.AuthSource == UserAuthSource.Ldap)
                        {
                            <p class="mb-1">
                                <strong>@T("Annuaire :")</strong>
                                @if (_user.LdapServerId is { } ldapServerId)
                                {
                                    <a href="@($"/config/auth/ldap/{ldapServerId}")" class="text-reset">@(_user.LdapServer?.Name ?? $"Annuaire #{ldapServerId}")</a>
                                }
                                else
                                {
                                    @T("aucun (annuaire supprimé depuis)")
                                }
                            </p>
                            <p class="mb-0"><strong>@T("DN :")</strong> @(_user.ExternalDn ?? "—")</p>
                        }
                        else
                        {
                            <p class="text-secondary small mb-0">
                                @T("Ce compte est rattaché à un annuaire LDAP dès qu'une connexion par bind LDAP y réussit (voir AccountController.Login) — pas de synchronisation planifiée, seulement au moment de la connexion.")
                            </p>
                        }
                    </div>
                    break;

                case "history":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>@T("Historique ({0})", _historyEntries.Count)</div>
                        @if (_historyEntries.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">@T("Aucun historique.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("ID")</th>
                                            <th>@T("Date")</th>
                                            <th>@T("Utilisateur")</th>
                                            <th>@T("Champ")</th>
                                            <th>@T("Mise à jour")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiUserHistoryEntry entry in Display.Chronological(_historyEntries, entry => entry.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "all":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-user"></i>@T("Utilisateur")</div>
                        <p class="mb-1"><strong>@T("Identifiant :")</strong> @_user.UserName</p>
                        <p class="mb-1"><strong>@T("Nom complet :")</strong> @(_user.DisplayName ?? "—")</p>
                        <p class="mb-1"><strong>@T("E-mail :")</strong> @(_user.Email ?? "—")</p>
                        <p class="mb-0"><strong>@T("Actif :")</strong> @YesNo(_user.IsActive)</p>
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-key"></i>@T("Habilitations ({0})", _userHabilitations.Count)</div>
                        @foreach (GlpiUserProfile h in _userHabilitations)
                        {
                            <p class="mb-1">@(h.Entity?.Name ?? T("Entité inconnue")) — @(h.Profile?.Name ?? T("Profil inconnu"))@(h.IsRecursive ? T(" (récursif)") : "")</p>
                        }
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-users"></i>@T("Groupes ({0})", _user.GroupMemberships.Count)</div>
                        @foreach (GlpiGroupUser membership in _user.GroupMemberships)
                        {
                            <p class="mb-1">@(membership.Group?.Name ?? T("Groupe inconnu"))</p>
                        }
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-shield"></i>@T("Sécurité")</div>
                        <p class="mb-0"><strong>@T("Désactiver l'obligation du 2FA :")</strong> @YesNo(_user.TwoFactorAuthDisabled)</p>
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>@T("Historique ({0})", _historyEntries.Count)</div>
                        @foreach (GlpiUserHistoryEntry entry in Display.Chronological(_historyEntries, entry => entry.OccurredAt))
                        {
                            <p class="mb-1">@Display.DateTime(entry.OccurredAt) — @entry.User — @entry.Field : @entry.Description</p>
                        }
                    </div>
                    break;

                default:
                    var current = _tabs.First(t => t.Key == _activeTabKey);
                    <div class="glping-config-placeholder">
                        <i class="ti @current.Icon"></i>
                        <p class="mb-0">
                            @if (UnavailableReasons.TryGetValue(_activeTabKey, out string? reason))
                            {
                                @reason
                            }
                            else
                            {
                                @:L'onglet « @T(current.Label) » n'est pas encore disponible.
                            }
                        </p>
                    </div>
                    break;
            }
        </div>
    </div>
}
