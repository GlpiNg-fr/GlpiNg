@page "/"
@rendermode InteractiveServer

<PageTitle>GlpiNg — Tableau de bord</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-3">
    <h2 class="page-title mb-0">Tableau de bord</h2>
</div>

<div class="row row-cards">
    @for (var i = 0; i < _cards.Count; i++)
    {
        var index = i;
        var card = _cards[i];
        <div class="col-sm-6 col-lg-3">
            <div class="card glpi-dashboard-card @(_draggedIndex == index ? "dragging" : "")"
                 draggable="true"
                 @ondragstart="() => OnCardDragStart(index)"
                 @ondragend="OnCardDragEnd"
                 @ondragover:preventDefault="true"
                 @ondrop="() => OnCardDrop(index)">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="glpi-dashboard-drag-handle" title="Glisser pour réorganiser">
                            <i class="ti ti-grip-vertical"></i>
                        </span>
                        <span class="@card.BadgeClass text-white avatar me-3"><i class="ti @card.Icon"></i></span>
                        <div>
                            <div class="text-secondary">@card.Title</div>
                            <div class="h2 mb-0">@card.Value</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
