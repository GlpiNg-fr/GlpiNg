@page "/"
@using GlpiNg.Web.Data
@inject GlpiNgDbContext Db
@rendermode InteractiveServer

<PageTitle>GlpiNg — Tableau de bord</PageTitle>

<h1>Tableau de bord</h1>

<div class="stats">
    <div class="stat-card">
        <span class="stat-value">@_computerCount</span>
        <span class="stat-label">Postes inventoriés</span>
    </div>
    <div class="stat-card">
        <span class="stat-value">@_agentCount</span>
        <span class="stat-label">Agents enregistrés</span>
    </div>
</div>

