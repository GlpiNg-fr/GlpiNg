@page "/"
@rendermode InteractiveServer

<PageTitle>GlpiNg — Tableau de bord</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between mb-3">
    <h2 class="page-title mb-0">Tableau de bord</h2>
</div>

<div class="row row-cards">
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="bg-primary text-white avatar me-3"><i class="ti ti-device-desktop"></i></span>
                    <div>
                        <div class="text-secondary">Postes inventoriés</div>
                        <div class="h2 mb-0">@_computerCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <span class="bg-azure text-white avatar me-3"><i class="ti ti-cpu"></i></span>
                    <div>
                        <div class="text-secondary">Agents enregistrés</div>
                        <div class="h2 mb-0">@_agentCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
