@page "/config/automatic-actions"
@using GlpiNg.Modules.Cron.Models
@rendermode InteractiveServer

<PageTitle>Actions automatiques — GlpiNg</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <span class="fw-semibold">@_rows.Count action(s)</span>
        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Fréquence</th>
                    <th>Dernière exécution</th>
                    <th>Statut</th>
                    <th>Activée</th>
                    <th style="width: 8rem;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">Aucune action automatique disponible.</td>
                    </tr>
                }
                else
                {
                    @foreach (Row row in _rows)
                    {
                        <tr>
                            <td>
                                <a href="@($"/config/automatic-actions/{row.Task.Key}")" class="text-reset fw-semibold">
                                    <i class="ti ti-robot me-1 text-secondary"></i>@row.Task.Name
                                </a>
                            </td>
                            <td>@FrequencyLabel(row)</td>
                            <td>@LastRunLabel(row.State)</td>
                            <td>
                                @if (row.State.LastRunAt is null)
                                {
                                    <span class="badge bg-secondary">—</span>
                                }
                                else if (row.State.LastRunSuccess == true)
                                {
                                    <span class="badge bg-success">Succès</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Échec</span>
                                }
                            </td>
                            <td>
                                <label class="glping-switch">
                                    <input type="checkbox" checked="@row.State.IsEnabled" @onchange="() => ToggleEnabledAsync(row)" />
                                    <span class="glping-switch-slider"></span>
                                </label>
                            </td>
                            <td>
                                <button type="button" class="btn btn-icon btn-sm" title="Lancer maintenant"
                                        disabled="@_runningKeys.Contains(row.Task.Key)" @onclick="() => RunNowAsync(row)">
                                    @if (_runningKeys.Contains(row.Task.Key))
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="ti ti-player-play"></i>
                                    }
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>
