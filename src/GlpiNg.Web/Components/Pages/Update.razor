@page "/update"
@layout GlpiNg.Web.Components.Layout.BlankLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Mise à niveau requise — GlpiNg</PageTitle>

<div class="glping-login">
    <div class="glping-login-card glping-update-card">
        <div class="glping-login-brand">
            <i class="ti ti-database-cog"></i>
            <span>GlpiNg</span>
        </div>

        @if (_pendingMigrations.Count == 0)
        {
            <p class="glping-login-message">La base de données est à jour.</p>
            <button type="button" class="glping-login-submit" @onclick="GoHome">Continuer</button>
        }
        else
        {
            <p class="glping-login-message">
                @(_pendingMigrations.Count == 1
                    ? "1 migration est en attente avant de pouvoir utiliser GlpiNg :"
                    : $"{_pendingMigrations.Count} migrations sont en attente avant de pouvoir utiliser GlpiNg :")
            </p>
            <ul class="glping-update-migration-list">
                @foreach (string migration in _pendingMigrations)
                {
                    <li><code>@migration</code></li>
                }
            </ul>

            <button type="button" class="glping-login-submit" disabled="@_applying" @onclick="ApplyAsync">
                @(_applying ? "Application en cours..." : "Confirmer la mise à niveau")
            </button>
        }
    </div>
</div>
