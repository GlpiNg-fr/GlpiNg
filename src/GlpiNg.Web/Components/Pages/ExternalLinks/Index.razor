@page "/config/external-links"
@using GlpiNg.Modules.Inventory.Services
@using GlpiNg.Web.Models.ExternalLinks
@rendermode InteractiveServer

<PageTitle>Liens externes — GlpiNg</PageTitle>

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Rechercher un lien..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count lien(s) sélectionné(s) ? Cette action est définitive.</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="OnRefreshAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newLinkModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        @* Ne coche que les lignes affichées : cocher ici ne doit jamais engager
                           plus que ce qu'on voit. *@
                        <input class="form-check-input m-0" type="checkbox" title="Sélectionner les éléments visibles"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>Nom</th>
                    <th>Adresse</th>
                    <th>Types associés</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">Aucun lien externe configuré.</td>
                    </tr>
                }
                else
                {
                    @foreach (ExternalLink link in _filtered)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(link.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(link.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/config/external-links/{link.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-external-link me-1 text-secondary"></i>@link.Name
                                </a>
                            </td>
                            <td class="text-secondary" style="word-break: break-all;">@link.Url</td>
                            <td>
                                @if (link.ItemTypes.Count == 0)
                                {
                                    @* Un lien sans type ne s'affiche sur aucune fiche : le dire ici
                                       évite de chercher pourquoi il reste invisible. *@
                                    <span class="badge bg-warning-lt">Aucun — invisible sur les fiches</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (ExternalLinkItemType association in link.ItemTypes.OrderBy(a => a.ItemType))
                                        {
                                            <span class="badge bg-secondary-lt">
                                                <i class="ti @ExternalLinkTagSource.IconFor(association.ItemType) me-1"></i>@ExternalLinkTagSource.LabelFor(association.ItemType)
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newLinkModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-external-link me-2"></i>Nouvel élément - Lien externe</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="glpi-fiche-field">
                    <label>Nom</label>
                    <input class="form-control" @bind="_newLink.Name" @bind:event="oninput" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Adresse</label>
                    <input class="form-control" placeholder="https://supervision.exemple.org/host/[NAME]"
                           @bind="_newLink.Url" @bind:event="oninput" />
                </div>
                <p class="hint">
                    Les types associés et les balises disponibles se règlent sur la fiche du lien,
                    une fois celui-ci créé.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@(!CanCreate)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
