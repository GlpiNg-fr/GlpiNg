@page "/preferences"
@using GlpiNg.Modules.Abstractions.Preferences
@using GlpiNg.Web.Services
@rendermode InteractiveServer

<PageTitle>@T("Préférences — GlpiNg")</PageTitle>

<div class="glping-fiche-topbar">
    <div class="glping-fiche-crumb">
        <i class="ti ti-adjustments"></i>
        <span>@T("Préférences")</span>
    </div>
</div>

@* Même disposition que les fiches (ordinateur...) : une catégorie par onglet. Tous les onglets
   éditent le même formulaire — le bouton Sauvegarder enregistre l'ensemble, quel que soit
   l'onglet affiché, et changer d'onglet ne perd rien de ce qui a été modifié. *@
<div class="glping-fiche-layout">
    <aside class="glping-fiche-sidebar">
        @foreach ((string key, string icon, string label) in Tabs)
        {
            <button type="button" class="glping-fiche-tab-item @(_activeTab == key ? "active" : "")" @onclick="() => _activeTab = key">
                <i class="ti @icon"></i>
                <span>@T(label)</span>
            </button>
        }
    </aside>

    <div class="glping-fiche-panel glping-fiche-panel-fill">
        <p class="text-secondary small">
            @T("Chaque réglage laissé sur « Réglage de l'instance » suit Configuration > Valeurs par défaut, et en suivra les changements.")
        </p>

        @switch (_activeTab)
        {
            case "affichage":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-layout-sidebar"></i>@T("Affichage")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Langue")</label>
                                <select class="form-select" value="@_language" @onchange="@(e => _language = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", LanguageCatalog.NativeNameOf(_instance.Language))</option>
                                    @* Chaque langue sous son propre nom, jamais traduit : c'est ainsi qu'on reconnaît la sienne. *@
                                    @foreach ((string languageCode, string nativeName) in LanguageCatalog.Languages)
                                    {
                                        <option value="@languageCode">@nativeName</option>
                                    }
                                </select>
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Réduire le menu latéral")</label>
                                <select class="form-select" value="@(_sidebarCollapsed ? "true" : "false")" @onchange="@(e => _sidebarCollapsed = e.Value?.ToString() == "true")">
                                    <option value="false">@T("Non")</option>
                                    <option value="true">@T("Oui")</option>
                                </select>
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Éléments par page")</label>
                                <select class="form-select" value="@_itemsPerPage.ToString()"
                                        @onchange="@(e => _itemsPerPage = int.TryParse((string?)e.Value, out int size) ? size : 0)">
                                    <option value="0">@T("Réglage de l'instance ({0})", InstanceItemsPerPage)</option>
                                    @foreach (int size in UserPreferencesProvider.ItemsPerPageOptions)
                                    {
                                        <option value="@size">@size</option>
                                    }
                                </select>
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Format des adresses MAC")</label>
                                <select class="form-select" value="@((int)_macAddressFormat)"
                                        @onchange="@(e => _macAddressFormat = int.TryParse((string?)e.Value, out int format) && Enum.IsDefined((MacAddressFormat)format) ? (MacAddressFormat)format : MacAddressFormat.Default)">
                                    @foreach (MacAddressFormat format in Enum.GetValues<MacAddressFormat>())
                                    {
                                        @* L'exemple sert de libellé : « ColonUpper » ne dit rien, « AA:BB:CC:DD:EE:FF »
                                           se reconnaît immédiatement. *@
                                        <option value="@((int)format)">
                                            @(format == MacAddressFormat.Default
                                                ? T("Réglage de l'instance ({0})", MacAddressFormatter.Sample(_instanceMacFormat))
                                                : MacAddressFormatter.Sample(format))
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Afficher les compteurs")</label>
                                <select class="form-select" value="@_showCounters" disabled="@CountersForbidden" @onchange="@(e => _showCounters = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", InstanceCountersLabel)</option>
                                    <option value="true">@T("Oui")</option>
                                    <option value="false">@T("Non")</option>
                                </select>
                            </div>
                            @if (CountersForbidden)
                            {
                                <p class="hint">@T("L'instance les interdit à tous (« Jamais ») : ce choix ne peut pas être changé ici.")</p>
                            }
                            <div class="glping-fiche-field">
                                <label>@T("Afficher les ID")</label>
                                <select class="form-select" value="@_showIds" @onchange="@(e => _showIds = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", YesNo(_instance.ShowGlpiIds))</option>
                                    <option value="true">@T("Oui")</option>
                                    <option value="false">@T("Non")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">
                        @T("Le nombre d'éléments par page s'applique à l'ouverture d'une liste ; il reste modifiable au pied de chaque tableau. Le format des adresses MAC ne change que l'affichage. Les compteurs sont ceux des onglets des fiches ; les ID suivent le nom des utilisateurs, groupes, entités et profils dans les listes de choix.")
                    </p>
                </div>
                break;

            case "apparence":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-palette"></i>@T("Palette de couleur")</div>
                    <div class="glping-palette-grid" role="radiogroup" aria-label="@(T("Palette de couleur"))" @ref="_paletteGrid">
                        @{
                            string instanceKey = PaletteCatalog.KeyOf(_instance.ColorPalette);
                        }
                        @* La première vignette suit l'instance : elle montre la palette qu'elle applique
                           aujourd'hui, et suivra celle qui la remplacera. *@
                        @PaletteCard(Inherit, T("Réglage de l'instance ({0})", InstancePaletteLabel), instanceKey)
                        @foreach ((string label, string key) in PaletteCatalog.Palettes)
                        {
                            @PaletteCard(label, label, key)
                        }
                    </div>
                    <p class="text-secondary small mt-2 mb-0">
                        @T("Palettes de GLPI. Darker et Midnight passent toute l'interface en sombre ; « Dark », comme dans GLPI, garde des pages claires sous un menu très sombre. Laissez la souris deux secondes sur une palette pour l'essayer sur toute la page ; elle n'est gardée qu'avec Sauvegarder.")
                    </p>
                </div>

                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-contrast"></i>@T("Accessibilité")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Contraste élevé")</label>
                                <select class="form-select" value="@_highContrast" @onchange="@(e => _highContrast = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", YesNo(_instance.HighContrast))</option>
                                    <option value="true">@T("Oui")</option>
                                    <option value="false">@T("Non")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">
                        @T("Texte à pleine encre, bordures franches, liens soulignés et focus clavier bien visible, quelle que soit la palette.")
                    </p>
                </div>
                break;

            case "dates":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-calendar-time"></i>@T("Dates et heures")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Format des dates")</label>
                                <select class="form-select" value="@_dateFormat" @onchange="@(e => _dateFormat = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", DateFormatLabel(_instance.DateFormat))</option>
                                    <option value="ymd">@T("AAAA-MM-JJ")</option>
                                    <option value="dmy">@T("JJ-MM-AAAA")</option>
                                    <option value="mdy">@T("MM-JJ-AAAA")</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Fuseau horaire")</label>
                                <select class="form-select" value="@_timezone" @onchange="@(e => _timezone = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", TimezoneLabel(_instance.Timezone))</option>
                                    <option value="server">@T("Fuseau du serveur")</option>
                                    @foreach ((string id, string label) in _timezones)
                                    {
                                        <option value="@id">@label</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">
                        @T("Aperçu :") <span class="fw-semibold">@Preview</span>@T(". Le fuseau s'applique aux instants enregistrés par l'application (ouverture d'un ticket, dernier contact d'un agent...). Les échéances et les planifications saisies à la main restent à l'heure où elles ont été saisies.")
                    </p>
                </div>
                break;

            case "personnes":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-users"></i>@T("Personnes")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Ordre d'affichage du nom complet")</label>
                                <select class="form-select" value="@_nameOrder" @onchange="@(e => _nameOrder = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", NameOrderLabel(_instance.FullNameOrder))</option>
                                    <option value="NomPrenom">@T("Nom Prénom")</option>
                                    <option value="PrenomNom">@T("Prénom Nom")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">@T("Pour les comptes dont le nom et le prénom sont renseignés.")</p>
                </div>
                break;

            case "historique":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-history"></i>@T("Historique")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Ordre de l'historique")</label>
                                <select class="form-select" value="@_historyOrder" @onchange="@(e => _historyOrder = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", HistoryOrderLabel(_instance.HistoryOrder))</option>
                                    <option value="natural">@T("Anciennes entrées en premier")</option>
                                    <option value="reverse">@T("Nouvelles entrées en premier")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">@T("Onglets Historique des fiches et fils de suivis de l'assistance.")</p>
                </div>
                break;

            case "exports":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-file-export"></i>@T("Exports")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Délimiteur CSV")</label>
                                <select class="form-select" value="@_csvDelimiter" @onchange="@(e => _csvDelimiter = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", _instance.CsvDelimiter)</option>
                                    <option value=";">;</option>
                                    <option value=",">,</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">@T("« ; » pour Excel en français, « , » pour la plupart des autres outils.")</p>
                </div>
                break;

            case "notifications":
                <div class="glping-fiche-block">
                    <div class="glping-fiche-block-title"><i class="ti ti-bell"></i>@T("Notifications")</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Notifications pour mes changements")</label>
                                <select class="form-select" value="@_notifyOnMyChanges" @onchange="@(e => _notifyOnMyChanges = e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Réglage de l'instance ({0})", YesNo(_instance.NotifyOnMyChanges))</option>
                                    <option value="true">@T("Oui")</option>
                                    <option value="false">@T("Non")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">
                        @T("Sur « Non », un courriel déclenché par votre propre action ne vous est pas envoyé.")
                    </p>
                </div>
                break;
        }

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Une vignette de palette : un aperçu miniature (menu, accent, bouton, page) et son nom. La
    /// sélection se lit à la bordure et à la coche, pas à la seule couleur.
    /// </summary>
    private RenderFragment PaletteCard(string value, string title, string key) => __builder =>
    {
        (string menuBg, string menuFg, string accent, string primary, string primaryFg, string pageBg) = PaletteCatalog.Previews[key];
        bool selected = string.Equals(_colorPalette, value, StringComparison.OrdinalIgnoreCase);

        <button type="button" class="glping-palette-card @(selected ? "selected" : "")" data-palette-key="@key" role="radio" aria-checked="@(selected ? "true" : "false")"
                @onclick="() => _colorPalette = value">
            <span class="glping-palette-preview" style="background: @pageBg;" aria-hidden="true">
                <span class="glping-palette-menu" style="background: @menuBg;">
                    <span class="glping-palette-dot" style="background: @accent;"></span>
                    <span class="glping-palette-line" style="background: @menuFg;"></span>
                    <span class="glping-palette-line" style="background: @menuFg;"></span>
                </span>
                <span class="glping-palette-button" style="background: @primary; color: @primaryFg;">Aa</span>
            </span>
            <span class="glping-palette-name">
                @if (selected)
                {
                    <i class="ti ti-circle-check-filled me-1"></i>
                }
                @title
            </span>
        </button>
    };
}
