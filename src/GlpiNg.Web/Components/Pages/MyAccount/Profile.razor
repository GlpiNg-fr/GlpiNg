@page "/mon-profil"
@using GlpiNg.Web.Models
@using GlpiNg.Web.Components.Pages.Users
@rendermode InteractiveServer

<PageTitle>@T("Mon profil — GlpiNg")</PageTitle>

@if (_user is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-user-off fs-1"></i>
        <p class="mt-2">@T("Impossible de charger votre profil.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-user"></i>
            <span>@T("Mon profil - {0}", _user.UserName)</span>
        </div>
    </div>

    <div class="glping-fiche-panel glping-fiche-panel-fill">
        <EditForm Model="_user" OnValidSubmit="SaveAsync">
            <div class="glping-fiche-block">
                <div class="glping-fiche-block-title"><i class="ti ti-id"></i>@T("Identité")</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="glping-fiche-field">
                            <label>@T("Identifiant")</label>
                            <input class="form-control" value="@_user.UserName" disabled />
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Prénom")</label>
                            <input class="form-control" @bind="_user.FirstName" />
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Lieu")</label>
                            <input class="form-control" @bind="_user.Location" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="glping-fiche-field">
                            <label>@T("Image")</label>
                            <span style="display:inline-flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border-radius:6px;color:#fff;font-size:1rem;font-weight:600;background:@UserAvatar.Color(_user)">@UserAvatar.Initials(_user)</span>
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Nom de famille")</label>
                            <input class="form-control" @bind="_user.LastName" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="glping-fiche-block">
                <div class="glping-fiche-block-title"><i class="ti ti-address-book"></i>@T("Coordonnées")</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="glping-fiche-field">
                            <label>@T("E-mail")</label>
                            <input class="form-control" type="email" @bind="_user.Email" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="glping-fiche-field">
                            <label>@T("Téléphone")</label>
                            <input class="form-control" @bind="_user.Phone" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="glping-fiche-block">
                <div class="glping-fiche-block-title"><i class="ti ti-key"></i>@T("Mot de passe")</div>
                @if (_user.AuthSource == UserAuthSource.Ldap)
                {
                    <p class="text-secondary small mb-0">
                        @T("Ce compte est authentifié via l'annuaire LDAP")
                        « @(_user.LdapServer?.Name ?? T("inconnu")) » @T(": le mot de passe ne peut pas être")
                        @T("modifié ici.")
                    </p>
                }
                else if (_showPasswordFields)
                {
                    <div class="row">
                        <div class="col-md-4">
                            <div class="glping-fiche-field">
                                <label>@T("Mot de passe actuel")</label>
                                <input class="form-control" type="password" @bind="_currentPassword" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glping-fiche-field">
                                <label>@T("Nouveau mot de passe")</label>
                                <input class="form-control" type="password" @bind="_newPassword" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glping-fiche-field">
                                <label>@T("Confirmer")</label>
                                <input class="form-control" type="password" @bind="_newPasswordConfirm" />
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm" @onclick="TogglePasswordFields">@T("Annuler")</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="TogglePasswordFields">
                        <i class="ti ti-lock me-1"></i>@T("Modifier le mot de passe")
                    </button>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                    <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                </button>
            </div>
        </EditForm>
    </div>
}
