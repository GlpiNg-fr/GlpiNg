@page "/config"
@using GlpiNg.Web.Components.Pages.ConfigSections
@rendermode InteractiveServer

<PageTitle>Configuration — GlpiNg</PageTitle>

<div class="glping-config">
    <aside class="glping-config-sidebar">
        @foreach (var section in Sections)
        {
            <button type="button"
                    class="glping-config-nav-item @(section.Key == _activeSection ? "active" : "")"
                    @onclick="() => SelectSection(section.Key)">
                <i class="ti @section.Icon"></i>
                <span>@section.Label</span>
            </button>
        }
    </aside>

    <div class="glping-config-body">
        @switch (_activeSection)
        {
            case "generale":
                <GeneralSection />
                break;
            case "valeurs-par-defaut":
                <DefaultValuesSection />
                break;
            case "parc":
                <ParcSection />
                break;
            case "assistance":
                <AssistanceSection />
                break;
            case "gestion":
                <GestionSection />
                break;
            case "purge":
                <PurgeSection />
                break;
            case "systeme":
                <SystemSection />
                break;
            case "securite":
                <SecuritySection />
                break;
            case "performance":
                <PerformanceSection />
                break;
            case "api":
                <ApiSection />
                break;
            case "analyse-impact":
                <ImpactAnalysisSection />
                break;
            case "colonnes":
                <DisplayColumnsSection />
                break;
            case "network":
                <GlpiNetworkSection />
                break;
            case "helpdesk":
                <HelpdeskSection />
                break;
            case "historique":
                <HistorySection />
                break;
            case "tous":
                <AllSections />
                break;
        }
    </div>
</div>
