@page "/login"
@layout GlpiNg.Web.Components.Layout.BlankLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using GlpiNg.Web.Models

<PageTitle>GlpiNg — Connexion</PageTitle>

<div class="glpi-login">
    <div class="glpi-login-card">
        <div class="glpi-login-brand">
            <i class="ti ti-server-2"></i>
            <span>GlpiNg</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_general?.LoginPageMessage))
        {
            <p class="glpi-login-message">@_general.LoginPageMessage</p>
        }

        <form method="post" action="/Account/Login" class="glpi-login-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="glpi-login-field">
                <label for="userName">Nom d'utilisateur</label>
                <input id="userName" name="userName" autocomplete="username" required autofocus />
            </div>

            <div class="glpi-login-field">
                <label for="password">Mot de passe</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required />
            </div>

            @if (_general?.ShowAuthSourcesOnLoginPage == true && _ldapServers.Count > 0)
            {
                <div class="glpi-login-field">
                    <label for="authSource">Source d'authentification</label>
                    @* « Automatique » en premier, donc sélectionné par défaut : la valeur vide ne
                       poste rien, et le serveur enchaîne mot de passe local puis annuaires. Avec
                       « Base GlpiNg (local) » en tête, un utilisateur qui ne touchait pas au
                       sélecteur imposait sans le savoir la source locale, et aucun annuaire
                       n'était essayé — échec indistinguable d'un mauvais mot de passe. *@
                    <select id="authSource" name="authSource">
                        <option value="">Automatique</option>
                        <option value="0">Base GlpiNg (local)</option>
                        @foreach (AuthLdapServer server in _ldapServers)
                        {
                            <option value="@server.Id">@server.Name</option>
                        }
                    </select>
                </div>
            }

            @if (_general is null || _general.RememberMeDuration > 0)
            {
                <div class="glpi-login-field checkbox">
                    <input id="rememberMe" name="rememberMe" type="checkbox" value="true" checked="@(_general?.RememberMeDefaultChecked ?? true)" />
                    <label for="rememberMe">Se souvenir de moi</label>
                </div>
            }

            <button type="submit" class="glpi-login-submit">Se connecter</button>
        </form>
    </div>
</div>
