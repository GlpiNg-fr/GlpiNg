@page "/admin/entities/{EntityId:int}"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>@(_entity?.Name ?? "Entité") — GlpiNg</PageTitle>

@if (_entity is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-sitemap fs-1"></i>
        <p class="mt-2">Cette entité est introuvable.</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <div class="glping-fiche-crumb">
            <i class="ti ti-sitemap"></i>
            <span>Entité - @_entity.Name - ID @_entity.Id</span>
            <button type="button" class="glping-fiche-favorite" title="Ajouter aux favoris">
                <i class="ti ti-star"></i>
            </button>
        </div>
        <div class="glping-fiche-toolbar">
            @if (_total > 0)
            {
                <span class="glping-fiche-pager-count">@_position/@_total</span>
                <a class="glping-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/admin/entities/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glping-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/admin/entities/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="glping-fiche-tab-item @(_activeTabKey == tab.Key ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                    <i class="ti @tab.Icon"></i>
                    <span>@tab.Label</span>
                    @if (tab.Count is { } count)
                    {
                        <span class="glping-fiche-tab-count">@count</span>
                    }
                </button>
            }
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "entite":
                    <EditForm Model="_entity" OnValidSubmit="SaveAsync">
                        <EntityFormFields Entity="_entity" ParentCandidates="ParentCandidates().ToList()" FullNameOf="FullName" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>Supprimer définitivement
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "adresse":
                    <EditForm Model="_entity" OnValidSubmit="SaveAsync">
                        <EntityAddressFields Entity="_entity" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>

                        <p class="text-secondary small mt-3 mb-0">
                            Créé le @Display.DateTime(_entity.CreatedAt)
                            — Dernière mise à jour le @Display.DateTime(_entity.UpdatedAt)
                        </p>
                    </EditForm>
                    break;

                case "sous-entites":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-sitemap"></i>Sous-entités (@_entity.Children.Count)</div>
                        @if (_entity.Children.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-sitemap"></i>
                                <p class="mb-0">Aucune sous-entité.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Commentaires</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiEntity child in _entity.Children.OrderBy(c => c.Name))
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/admin/entities/{child.Id}")" class="text-reset">
                                                        <i class="ti ti-sitemap me-1 text-secondary"></i>@child.Name
                                                    </a>
                                                </td>
                                                <td>@(child.Comment ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <div class="d-flex gap-2 mt-3">
                            <input class="form-control" style="max-width: 320px;" placeholder="Nom de la sous-entité" @bind="_newSubEntityName" @bind:event="oninput" />
                            <button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_newSubEntityName)" @onclick="AddSubEntityAsync">
                                <i class="ti ti-plus me-1"></i>Ajouter
                            </button>
                        </div>
                    </div>
                    break;

                case "avance":
                    <EditForm Model="_entity" OnValidSubmit="SaveAsync">
                        <div class="glping-fiche-block-title"><i class="ti ti-settings"></i>Valeurs pour les règles génériques d'affectation à l'entité</div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>Balise (TAG) de l'outil d'inventaire représentant l'entité</label>
                                    <input class="form-control" @bind="_entity.AssignmentTag" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>Domaine de messagerie représentant l'entité</label>
                                    <input class="form-control" @bind="_entity.AssignmentEmailDomain" />
                                </div>
                            </div>
                        </div>
                        <p class="text-secondary small">GlpiNg n'a pas d'annuaire LDAP : ces champs ne sont pas encore exploités par l'import d'inventaire.</p>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "securite":
                    <EditForm Model="_entity" OnValidSubmit="SaveAsync">
                        <div class="glping-fiche-block-title"><i class="ti ti-shield"></i>Double authentification (2FA)</div>
                        <p class="text-secondary small">Si la double authentification est imposée, les utilisateurs rattachés à cette entité devront l'utiliser à la connexion.</p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>Forcer 2FA</label>
                                    <select class="form-select" value="@(_entity.TwoFactorAuthRequired ? "true" : "false")" @onchange="@(e => _entity.TwoFactorAuthRequired = e.Value?.ToString() == "true")">
                                        <option value="false">Non</option>
                                        <option value="true">Oui</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "parc":
                    <EditForm Model="_entity" OnValidSubmit="SaveAsync">
                        <div class="glping-fiche-block-title"><i class="ti ti-cloud-upload"></i>Inventaire automatique</div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>URL Base pour l'agent</label>
                                    <input class="form-control" @bind="_entity.AgentBaseUrl" placeholder="https://..." />
                                </div>
                            </div>
                        </div>
                        <p class="text-secondary small">GlpiNg n'a pas de modules financiers/logiciels/transfert : les autres réglages GLPI de l'onglet Parc ne s'appliquent pas ici.</p>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "interface":
                    <EditForm Model="_entity" OnValidSubmit="SaveAsync">
                        <div class="glping-fiche-block-title"><i class="ti ti-layout"></i>Personnalisation CSS</div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>Activer la personnalisation CSS</label>
                                    <select class="form-select" value="@(_entity.CustomCssEnabled ? "true" : "false")" @onchange="@(e => _entity.CustomCssEnabled = e.Value?.ToString() == "true")">
                                        <option value="false">Non</option>
                                        <option value="true">Oui</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        @if (_entity.CustomCssEnabled)
                        {
                            <div class="glping-fiche-field">
                                <label>CSS personnalisé</label>
                                <textarea class="form-control" rows="6" @bind="_entity.CustomCss"></textarea>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary small">Le CSS personnalisé est désactivé.</p>
                        }

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "utilisateurs":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-plus"></i>Ajouter une habilitation</div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Profil</th>
                                        <th>Récursif</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <select class="form-select" @bind="_userIdToAssign">
                                                <option value="0">-- Choisir --</option>
                                                @foreach (GlpiUser user in _allUsers)
                                                {
                                                    <option value="@user.Id">@(user.DisplayName ?? user.UserName)</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select" @bind="_profileIdToAssign">
                                                <option value="0">-- Choisir --</option>
                                                @foreach (GlpiProfile profile in _allProfiles)
                                                {
                                                    <option value="@profile.Id">@profile.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select" value="@(_isRecursiveToAssign ? "true" : "false")" @onchange="@(e => _isRecursiveToAssign = e.Value?.ToString() == "true")">
                                                <option value="false">Non</option>
                                                <option value="true">Oui</option>
                                            </select>
                                        </td>
                                        <td style="width: 8rem;">
                                            <button type="button" class="btn btn-primary w-100" disabled="@(_userIdToAssign == 0 || _profileIdToAssign == 0)" @onclick="AddHabilitationAsync">
                                                <i class="ti ti-plus me-1"></i>Ajouter
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="glping-fiche-block-title mt-3"><i class="ti ti-user"></i>Utilisateurs (@_entityHabilitations.Count)</div>
                        @if (_entityHabilitations.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-user"></i>
                                <p class="mb-0">Aucune habilitation sur cette entité.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Utilisateur</th>
                                            <th>Profil</th>
                                            <th>Récursif</th>
                                            <th style="width: 6rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiUserProfile h in _entityHabilitations.OrderBy(h => h.User?.DisplayName ?? h.User?.UserName ?? string.Empty))
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/admin/users/{h.UserId}")" class="text-reset">
                                                        <i class="ti ti-user me-1 text-secondary"></i>@(h.User?.DisplayName ?? h.User?.UserName ?? "Utilisateur inconnu")
                                                    </a>
                                                </td>
                                                <td>@(h.Profile?.Name ?? "Profil inconnu")</td>
                                                <td>@(h.IsRecursive ? "Oui" : "Non")</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Détacher" @onclick="() => RemoveHabilitationAsync(h.Id)">
                                                        <i class="ti ti-x"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "notes":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-notes"></i>Notes (@_notes.Count)</div>
                        @if (_notes.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-notes"></i>
                                <p class="mb-0">Aucune note.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (GlpiEntityNote note in _notes)
                            {
                                <div class="glping-fiche-block mb-2">
                                    <p class="mb-1" style="white-space: pre-wrap;">@note.Content</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-secondary small">@note.Author — @Display.DateTime(note.CreatedAt)</span>
                                        <button type="button" class="btn btn-icon btn-sm text-danger" title="Supprimer" @onclick="() => DeleteNoteAsync(note.Id)">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        <div class="d-flex gap-2 mt-3">
                            <textarea class="form-control" rows="3" placeholder="Nouvelle note..." @bind="_newNoteContent" @bind:event="oninput"></textarea>
                            <button type="button" class="btn btn-primary align-self-start" disabled="@string.IsNullOrWhiteSpace(_newNoteContent)" @onclick="AddNoteAsync">
                                <i class="ti ti-plus me-1"></i>Ajouter
                            </button>
                        </div>
                    </div>
                    break;

                case "history":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>Historique (@_historyEntries.Count)</div>
                        @if (_historyEntries.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">Aucun historique.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Utilisateur</th>
                                            <th>Champ</th>
                                            <th>Mise à jour</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiEntityHistoryEntry entry in Display.Chronological(_historyEntries, entry => entry.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "all":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-sitemap"></i>Entité</div>
                        <p class="mb-1"><strong>Nom :</strong> @_entity.Name</p>
                        <p class="mb-1"><strong>Comme enfant de :</strong> @ParentLabel(_entity.ParentId)</p>
                        <p class="mb-0"><strong>Commentaires :</strong> @(_entity.Comment ?? "—")</p>
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-map-pin"></i>Adresse</div>
                        <p class="mb-1"><strong>Téléphone :</strong> @(_entity.Phone ?? "—") — <strong>E-mail :</strong> @(_entity.Email ?? "—")</p>
                        <p class="mb-0"><strong>Adresse :</strong> @(_entity.Address ?? "—"), @(_entity.Postcode ?? "") @(_entity.Town ?? "") @(_entity.Country ?? "")</p>
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-settings"></i>Paramètres</div>
                        <p class="mb-1"><strong>Forcer 2FA :</strong> @YesNo(_entity.TwoFactorAuthRequired)</p>
                        <p class="mb-1"><strong>URL Base pour l'agent :</strong> @(_entity.AgentBaseUrl ?? "—")</p>
                        <p class="mb-0"><strong>CSS personnalisé :</strong> @YesNo(_entity.CustomCssEnabled)</p>
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-hierarchy"></i>Entités (@_entity.Children.Count)</div>
                        @foreach (GlpiEntity child in _entity.Children.OrderBy(c => c.Name))
                        {
                            <p class="mb-1"><a href="@($"/admin/entities/{child.Id}")">@child.Name</a></p>
                        }
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-user"></i>Utilisateurs (@_entityHabilitations.Count)</div>
                        @foreach (GlpiUserProfile h in _entityHabilitations)
                        {
                            <p class="mb-1">@(h.User?.DisplayName ?? h.User?.UserName ?? "Utilisateur inconnu") — @(h.Profile?.Name ?? "Profil inconnu")</p>
                        }
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-notes"></i>Notes (@_notes.Count)</div>
                        @foreach (GlpiEntityNote note in _notes)
                        {
                            <p class="mb-1" style="white-space: pre-wrap;">@note.Content <span class="text-secondary small">(@note.Author, @Display.DateTime(note.CreatedAt))</span></p>
                        }
                    </div>
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>Historique (@_historyEntries.Count)</div>
                        @foreach (GlpiEntityHistoryEntry entry in Display.Chronological(_historyEntries, entry => entry.OccurredAt))
                        {
                            <p class="mb-1">@Display.DateTime(entry.OccurredAt) — @entry.User — @entry.Field : @entry.Description</p>
                        }
                    </div>
                    break;

                default:
                    var current = _tabs.First(t => t.Key == _activeTabKey);
                    <div class="glping-config-placeholder">
                        <i class="ti @current.Icon"></i>
                        <p class="mb-0">
                            @if (UnavailableReasons.TryGetValue(_activeTabKey, out string? reason))
                            {
                                @reason
                            }
                            else
                            {
                                @:L'onglet « @current.Label » n'est pas encore disponible.
                            }
                        </p>
                    </div>
                    break;
            }
        </div>
    </div>
}
