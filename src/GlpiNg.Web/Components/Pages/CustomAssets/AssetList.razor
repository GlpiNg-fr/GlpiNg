@page "/parc/custom/{SystemName}"
@using GlpiNg.Web.Models.CustomAssets
@rendermode InteractiveServer

<PageTitle>@(_definition?.LabelPlural ?? T("Actifs")) — GlpiNg</PageTitle>

@if (_definition is null)
{
    <div class="card">
        <div class="card-body text-center text-secondary py-5">
            @T("Ce type d'actif n'existe pas (ou plus).")
            <div class="mt-2">
                <a href="/config/custom-assets">@T("Voir les types d'actifs personnalisés")</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="glping-list-page">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
            <div class="btn-list">
                <div class="dropdown">
                    <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="ti ti-search me-1"></i>@T("Rechercher")
                    </button>
                    <div class="dropdown-menu p-3" style="min-width: 280px;">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" class="form-control" placeholder="@(T("Rechercher..."))"
                                   @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                        </div>
                    </div>
                </div>

                @if (!_definition.IsActive)
                {
                    <span class="badge bg-warning-lt align-self-center">
                        @T("Type inactif — masqué du menu, ses actifs restent accessibles par cette adresse")
                    </span>
                }
            </div>

            <div class="btn-list align-items-center">
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            disabled="@(_selectedIds.Count == 0)" title="@(T("Supprimer la sélection"))">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <p class="mb-2">@T("Supprimer {0} élément(s) ? Cette action est définitive.", _selectedIds.Count)</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">@T("Supprimer")</button>
                        </div>
                    </div>
                </div>

                <button type="button" class="btn btn-icon" @onclick="OnRefreshAsync" title="@(T("Rafraîchir"))">
                    <i class="ti ti-refresh"></i>
                </button>

                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newAssetModal">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;">
                            <input class="form-check-input m-0" type="checkbox" title="@(T("Sélectionner les éléments visibles"))"
                                   checked="@AllSelected"
                                   @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                        </th>
                        <th>@T("Nom")</th>
                        @foreach (CustomAssetField field in _fields)
                        {
                            <th>@field.Label</th>
                        }
                        <th>@T("Dernière modification")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filtered.Count == 0)
                    {
                        <tr>
                            <td colspan="@(_fields.Count + 3)" class="text-center text-secondary py-4">
                                @T("Aucun élément.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (CustomAsset asset in _filtered)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(asset.Id)"
                                           @onchange="@((ChangeEventArgs e) => ToggleSelect(asset.Id, (bool)(e.Value ?? false)))" />
                                </td>
                                <td>
                                    <a href="@($"/parc/custom/{_definition.SystemName}/{asset.Id}")" class="text-reset fw-semibold">
                                        <i class="ti @_definition.Icon me-1 text-secondary"></i>@asset.Name
                                    </a>
                                </td>
                                @foreach (CustomAssetField field in _fields)
                                {
                                    <td class="text-secondary">@DisplayValue(asset, field)</td>
                                }
                                <td class="text-secondary">@Display.DateTime(asset.UpdatedAt)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>

    <div class="modal fade" id="newAssetModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti @_definition.Icon me-2"></i>@T("Nouvel élément - {0}", _definition.LabelSingular)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
                </div>
                <div class="modal-body">
                    @if (_createError is not null)
                    {
                        <div class="alert alert-danger">@_createError</div>
                    }

                    <div class="glping-fiche-field">
                        <label>@T("Nom")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                        <input class="form-control" @bind="_newName" @bind:event="oninput" />
                    </div>

                    @foreach (CustomAssetField field in _fields)
                    {
                        <CustomAssetFieldInput Field="field"
                                               Value="@GetNewValue(field)"
                                               Options="OptionsFor(field)"
                                               ValueChanged="@(value => SetNewValue(field, value))" />
                    }

                    <div class="glping-fiche-field">
                        <label>@T("Commentaires")</label>
                        <textarea class="form-control" rows="2" @bind="_newComment"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newName)"
                            @onclick="CreateAsync">
                        <i class="ti ti-plus me-1"></i>@T("Ajouter")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
