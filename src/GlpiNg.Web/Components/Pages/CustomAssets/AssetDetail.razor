@page "/parc/custom/{SystemName}/{AssetId:int}"
@using GlpiNg.Modules.Abstractions.Documents
@using GlpiNg.Modules.Abstractions.Notes
@using GlpiNg.Web.Models.CustomAssets
@rendermode InteractiveServer

<PageTitle>@(_asset?.Name ?? T("Actif")) — GlpiNg</PageTitle>

@if (_definition is null || _asset is null)
{
    <div class="card">
        <div class="card-body text-center text-secondary py-5">@T("Élément introuvable.")</div>
    </div>
}
else
{
    <div class="glping-fiche">
        <div class="glping-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0">
                <i class="ti @_definition.Icon me-2"></i>@_asset.Name
                <span class="text-secondary fs-4 ms-2">@_definition.LabelSingular</span>
            </h2>
            <div class="btn-list">
                <a class="btn" href="@($"/parc/custom/{_definition.SystemName}")">
                    <i class="ti ti-arrow-left me-1"></i>@T("Retour à la liste")
                </a>
                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="@(T("Supprimer"))">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                        <p class="mb-2">@T("Supprimer cet élément ? Cette action est définitive.")</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">@T("Supprimer")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="glping-fiche-layout">
            <aside class="glping-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glping-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => SetTab(key)">
                        <i class="ti @icon"></i>
                        <span>@T(label)</span>
                        @if (count is { } value)
                        {
                            <span class="glping-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glping-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_saveError is not null)
                        {
                            <div class="alert alert-danger">@_saveError</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Nom")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                                    <input class="form-control" @bind="_asset.Name" />
                                </div>

                                @foreach (CustomAssetField field in _fields)
                                {
                                    <CustomAssetFieldInput Field="field"
                                                           Value="@GetValue(field)"
                                                           Options="OptionsFor(field)"
                                                           ValueChanged="@(value => SetValue(field, value))" />
                                }
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Commentaires")</label>
                                    <textarea class="form-control" rows="4" @bind="_asset.Comment"></textarea>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Dernière modification")</label>
                                    <input class="form-control" disabled
                                           value="@Display.DateTime(_asset.UpdatedAt)" />
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                                <i class="ti ti-device-floppy me-1"></i>@T("Enregistrer")
                            </button>
                        </div>
                        break;

                    case "documents":
                        <p class="text-secondary">
                            @T("Fichiers rattachés à cet élément. Un document déjà présent dans GlpiNg peut être rattaché sans être téléversé une seconde fois.")
                        </p>

                        <div class="mb-3">
                            <label class="form-label">@T("Ajouter un fichier")</label>
                            <InputFile class="form-control" OnChange="OnDocumentSelectedAsync" />
                            @if (_documentError is not null)
                            {
                                <div class="alert alert-danger mt-2">@_documentError</div>
                            }
                        </div>

                        @if (_documents.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-file-off"></i>
                                <p class="mb-0">@T("Aucun document rattaché.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                            <th>@T("Fichier")</th>
                                            <th>@T("Taille")</th>
                                            <th>@T("Ajouté le")</th>
                                            <th style="width: 6rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (DocumentSummary document in _documents)
                                        {
                                            <tr>
                                                <td>@document.Name</td>
                                                <td class="text-secondary">@document.FileName</td>
                                                <td class="text-secondary">@FormatSize(document.SizeBytes)</td>
                                                <td class="text-secondary">@Display.DateTime(document.CreatedAt)</td>
                                                <td class="text-nowrap">
                                                    @if (!document.IsContentMissing)
                                                    {
                                                        <a class="btn btn-icon btn-sm" title="@(T("Télécharger"))"
                                                           href="@Documents.DownloadUrl(document.Id)">
                                                            <i class="ti ti-download"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-lt">@T("Fichier absent")</span>
                                                    }
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Détacher"))"
                                                            @onclick="() => DetachDocumentAsync(document.Id)">
                                                        <i class="ti ti-unlink"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "notes":
                        <p class="text-secondary">
                            @T("Notes libres attachées à cet élément : le carnet de bord de ceux qui l'exploitent.")
                        </p>

                        <div class="mb-3">
                            <label class="form-label" for="ca-new-note">@T("Ajouter une note")</label>
                            <textarea id="ca-new-note" class="form-control" rows="3"
                                      @bind="_newNote" @bind:event="oninput"></textarea>
                            <button type="button" class="btn btn-primary mt-2"
                                    disabled="@string.IsNullOrWhiteSpace(_newNote)" @onclick="AddNoteAsync">
                                <i class="ti ti-plus me-1"></i>@T("Ajouter")
                            </button>
                        </div>

                        @if (_notes.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-notes-off"></i>
                                <p class="mb-0">@T("Aucune note pour cet élément.")</p>
                            </div>
                        }
                        else
                        {
                            @foreach (ItemNote note in _notes)
                            {
                                <div class="card mb-2">
                                    <div class="card-body">
                                        @* Texte brut, volontairement : cette fiche n'a pas de rendu Markdown,
                                           et interpréter du balisage ici obligerait à l'assainir. *@
                                        <div style="white-space: pre-wrap;">@note.Content</div>

                                        <div class="d-flex align-items-center justify-content-between mt-2">
                                            <div class="text-secondary small">
                                                <i class="ti ti-user me-1"></i>@note.AuthorName
                                                <span class="ms-2">
                                                    <i class="ti ti-calendar me-1"></i>@Display.DateTime(note.CreatedAt)
                                                </span>
                                            </div>
                                            <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Supprimer"))"
                                                    @onclick="() => DeleteNoteAsync(note.Id)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        break;

                    case "historique":
                        @if (_history.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">@T("Aucune modification enregistrée.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th style="width: 12rem;">@T("Date")</th>
                                            <th style="width: 10rem;">@T("Auteur")</th>
                                            <th style="width: 12rem;">@T("Champ")</th>
                                            <th>@T("Modification")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (CustomAssetHistoryEntry entry in Display.Chronological(_history, entry => entry.OccurredAt))
                                        {
                                            <tr>
                                                <td class="text-secondary">@Display.DateTime(entry.OccurredAt)</td>
                                                <td class="text-secondary">@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td class="text-secondary">@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;
                }
            </div>
        </div>
    </div>
}
