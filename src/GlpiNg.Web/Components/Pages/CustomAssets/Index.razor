@page "/config/custom-assets"
@using GlpiNg.Web.Models.CustomAssets
@rendermode InteractiveServer

<PageTitle>Actifs personnalisés — GlpiNg</PageTitle>

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Rechercher un type..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="OnRefreshAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newDefinitionModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Libellé</th>
                    <th>Nom technique</th>
                    <th>Champs</th>
                    <th>Actifs</th>
                    <th>Onglets</th>
                    <th>Actif</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">Aucun type d'actif personnalisé.</td>
                    </tr>
                }
                else
                {
                    @foreach (CustomAssetDefinition definition in _filtered)
                    {
                        <tr>
                            <td>
                                <a href="@($"/config/custom-assets/{definition.Id}")" class="text-reset fw-semibold">
                                    <i class="ti @definition.Icon me-1 text-secondary"></i>@definition.LabelSingular
                                </a>
                            </td>
                            <td class="text-secondary">@definition.SystemName</td>
                            <td>
                                @if (definition.Fields.Count == 0)
                                {
                                    <span class="badge bg-secondary-lt">Aucun — nom et commentaire seulement</span>
                                }
                                else
                                {
                                    <span class="text-secondary">@definition.Fields.Count champ(s)</span>
                                }
                            </td>
                            <td class="text-secondary">
                                @if (_assetCounts.TryGetValue(definition.Id, out int count) && count > 0)
                                {
                                    <a href="@($"/parc/custom/{definition.SystemName}")">@count</a>
                                }
                                else
                                {
                                    <text>0</text>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (definition.DocumentsEnabled)
                                    {
                                        <span class="badge bg-secondary-lt">Documents</span>
                                    }
                                    @if (definition.NotesEnabled)
                                    {
                                        <span class="badge bg-secondary-lt">Notes</span>
                                    }
                                    @if (definition.HistoryEnabled)
                                    {
                                        <span class="badge bg-secondary-lt">Historique</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (definition.IsActive)
                                {
                                    <span class="badge bg-success-lt">Oui</span>
                                }
                                else
                                {
                                    @* Un type inactif garde ses actifs : le dire évite de croire qu'ils ont disparu. *@
                                    <span class="badge bg-warning-lt">Non — masqué du menu Parc</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newDefinitionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-tool me-2"></i>Nouvel élément - Actif personnalisé</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                @if (_createError is not null)
                {
                    <div class="alert alert-danger">@_createError</div>
                }

                <div class="glpi-fiche-field">
                    <label>Libellé au singulier</label>
                    <input class="form-control" placeholder="Vidéoprojecteur"
                           value="@_newDefinition.LabelSingular" @oninput="OnSingularChanged" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Libellé au pluriel</label>
                    <input class="form-control" placeholder="Vidéoprojecteurs"
                           @bind="_newDefinition.LabelPlural" @bind:event="oninput" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Nom technique</label>
                    <input class="form-control" @bind="_newDefinition.SystemName" @bind:event="oninput" />
                    <p class="hint">
                        Sert d'adresse (<code>/parc/custom/@(_newDefinition.SystemName)</code>) et de
                        référence pour les documents et les notes. Lettres et chiffres sans espace ni
                        accent, et définitif : le changer détacherait les pièces jointes déjà posées.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@(!CanCreate)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
