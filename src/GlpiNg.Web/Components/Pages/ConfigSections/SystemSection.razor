@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject AppSettingsFileStore SettingsStore

@if (_settings is null)
{
    <p>Chargement…</p>
}
else
{
    <EditForm Model="_settings" OnValidSubmit="SaveAsync" class="glpi-config-form">
        <div class="glpi-config-field">
            <label for="urls">Adresses d'écoute du serveur</label>
            <input id="urls" @bind="_settings.Urls" placeholder="http://0.0.0.0:5000" />
        </div>
        <p class="hint">
            Clé de configuration "Urls" (adresses d'écoute Kestrel). Un
            redémarrage de l'application est nécessaire pour appliquer ce
            changement. Si un argument <code>--urls</code> ou une autre source de
            configuration définit aussi les adresses d'écoute, vérifiez laquelle
            l'emporte sur votre déploiement avant de vous fier uniquement à cette page.
        </p>

        <div class="glpi-config-field checkbox">
            <label for="swagger">Activer Swagger (/swagger)</label>
            <input id="swagger" type="checkbox" @bind="_settings.SwaggerEnabled" />
        </div>
        <p class="hint">Pris en compte immédiatement, sans redémarrage.</p>

        @if (_statusMessage is not null)
        {
            <p class="status">@_statusMessage</p>
        }

        <button type="submit" class="glpi-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private ServerSettings? _settings;
    private bool _isSaving;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsStore.ReadAsync();
    }

    private async Task SaveAsync()
    {
        if (_settings is null)
        {
            return;
        }

        _isSaving = true;
        _statusMessage = null;

        try
        {
            await SettingsStore.SaveAsync(_settings);
            _statusMessage = "Configuration enregistrée.";
        }
        catch (IOException ex)
        {
            _statusMessage = $"Échec de l'enregistrement : {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
