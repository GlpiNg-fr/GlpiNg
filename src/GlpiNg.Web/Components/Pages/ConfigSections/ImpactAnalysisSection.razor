@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_model is null)
{
    <p>Chargement…</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glpi-config-form">
        <p class="hint" style="margin-left:0;">Types d'éléments proposés dans les graphes d'analyse d'impact.</p>

        <div class="glpi-checkbox-grid">
            @foreach (var (key, label) in ImpactAnalysisSettings.AvailableItemTypes)
            {
                <label>
                    <input type="checkbox" checked="@_model.EnabledItemTypes.Contains(key)" @onchange="e => Toggle(key, (bool)e.Value!)" />
                    @label
                </label>
            }
        </div>

        <button type="submit" class="glpi-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private const string SectionName = "ImpactAnalysisSettings";

    private ImpactAnalysisSettings? _model;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _model = await SettingsStore.ReadSectionAsync<ImpactAnalysisSettings>(SectionName);
    }

    private void Toggle(string itemType, bool enabled)
    {
        if (_model is null)
        {
            return;
        }

        if (enabled && !_model.EnabledItemTypes.Contains(itemType))
        {
            _model.EnabledItemTypes.Add(itemType);
        }
        else if (!enabled)
        {
            _model.EnabledItemTypes.Remove(itemType);
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<ImpactAnalysisSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
