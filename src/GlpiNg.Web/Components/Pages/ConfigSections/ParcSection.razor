@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@using GlpiNg.Web.Components.Shared
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService
@implements IDisposable

@if (_modules is null || _model is null)
{
    <p>@T("Chargement…")</p>
}
else
{
    @* L'interrupteur du module est porté par la ligne de titre elle-même : il commande tout ce que
       la carte contient, et reste donc accessible sans la déplier. *@
    <CardExpander Title="@(T("Module Inventaire"))" Icon="ti-box" Expanded="false">
        <HeaderActions>
            <label class="glping-switch" title="@(T("Activer ou désactiver tout le module Inventaire"))">
                <input type="checkbox" checked="@_moduleEnabled" @onchange="OnModuleMasterToggled" />
                <span class="glping-switch-slider"></span>
            </label>
        </HeaderActions>
        <ChildContent>
            <ModuleToggleList GroupKey="parc" Items="ModuleItems" Modules="_modules" OnToggle="OnModuleToggled" Disabled="@(!_moduleEnabled)" />
        </ChildContent>
    </CardExpander>

    <div class="glping-config-divider">
        <span><i class="ti ti-box"></i> @T("Réglages du parc")</span>
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glping-config-form">
        <div class="glping-config-field checkbox">
            <label for="parc-infocoms">@T("Activer les informations financières et administratives par défaut")</label>
            <label class="glping-switch">
                <input id="parc-infocoms" type="checkbox" @bind="_model.AutoCreateFinancialInfo" />
                <span class="glping-switch-slider"></span>
            </label>
        </div>

        <div class="glping-config-field">
            <label for="parc-monitors-restrict">@T("Restreindre la gestion des moniteurs")</label>
            <select id="parc-monitors-restrict" @bind="_model.MonitorsManagementRestrict">
                <option value="0">@T("Oui - Restreint à la gestion unitaire")</option>
                <option value="1">@T("Oui - Restreint à la gestion globale")</option>
                <option value="2">@T("Non")</option>
            </select>
        </div>

        <div class="glping-config-field">
            <label for="parc-peripherals-restrict">@T("Restreindre la gestion des périphériques")</label>
            <select id="parc-peripherals-restrict" @bind="_model.PeripheralsManagementRestrict">
                <option value="0">@T("Oui - Restreint à la gestion unitaire")</option>
                <option value="1">@T("Oui - Restreint à la gestion globale")</option>
                <option value="2">@T("Non")</option>
            </select>
        </div>

        <div class="glping-config-field">
            <label for="parc-phones-restrict">@T("Restreindre la gestion des téléphones")</label>
            <select id="parc-phones-restrict" @bind="_model.PhonesManagementRestrict">
                <option value="0">@T("Oui - Restreint à la gestion unitaire")</option>
                <option value="1">@T("Oui - Restreint à la gestion globale")</option>
                <option value="2">@T("Non")</option>
            </select>
        </div>

        <div class="glping-config-field">
            <label for="parc-printers-restrict">@T("Restreindre la gestion des imprimantes")</label>
            <select id="parc-printers-restrict" @bind="_model.PrintersManagementRestrict">
                <option value="0">@T("Oui - Restreint à la gestion unitaire")</option>
                <option value="1">@T("Oui - Restreint à la gestion globale")</option>
                <option value="2">@T("Non")</option>
            </select>
        </div>

        <div class="glping-config-field">
            <label for="parc-autoname">@T("Champs automatiques (marqués par *)")</label>
            <select id="parc-autoname" @bind="_model.AutonameScope">
                <option value="0">@T("Global")</option>
                <option value="1">@T("Par entité")</option>
            </select>
        </div>

        <button type="submit" class="glping-config-save" disabled="@_isSaving">@(_isSaving ? T("Enregistrement…") : T("Enregistrer"))</button>
    </EditForm>
}

@code {
    private const string SectionName = "ParcSettings";

    public static readonly List<(string Label, string Icon)> ModuleItems =
    [
        ("Moniteurs", "ti-device-tv"),
        ("Logiciels", "ti-apps"),
        ("Matériels réseau", "ti-router"),
        ("Périphériques", "ti-mouse"),
        ("Imprimantes", "ti-printer"),
        ("Cartouches", "ti-droplet"),
        ("Consommables", "ti-package"),
        ("Téléphones", "ti-phone"),
        ("Baies", "ti-server-2"),
        ("Châssis", "ti-layout-grid"),
        ("PDU", "ti-plug"),
        ("Équipements passifs", "ti-plug-connected"),
        ("Actifs non gérés", "ti-help"),
        ("Câbles", "ti-cable"),
        ("Carte SIM éléments", "ti-sim-card"),
        ("Global", "ti-world"),
    ];

    private ModulesSettings? _modules;
    private ParcSettings? _model;
    private bool _moduleEnabled = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
        _model = await SettingsStore.ReadSectionAsync<ParcSettings>(SectionName);
        _moduleEnabled = _modules.IsModuleEnabled("parc");
        SettingsStore.SectionSaved += OnSettingsSectionSaved;
    }

    /// <summary>
    /// Un autre écran — ou un autre administrateur — vient de basculer un module : les interrupteurs
    /// de cette carte reprennent la valeur enregistrée, comme le menu latéral de chacun.
    /// </summary>
    private void OnSettingsSectionSaved(string sectionName)
    {
        if (sectionName != "ModulesSettings")
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
            _moduleEnabled = _modules.IsModuleEnabled("parc");
            StateHasChanged();
        });
    }

    public void Dispose() => SettingsStore.SectionSaved -= OnSettingsSectionSaved;

    private async Task OnModuleMasterToggled(ChangeEventArgs e)
    {
        if (_modules is null)
        {
            return;
        }

        var enabled = (bool)e.Value!;
        _modules = await SettingsStore.UpdateSectionAsync<ModulesSettings>("ModulesSettings", modules => modules.SetModuleEnabled("parc", enabled));
        _moduleEnabled = enabled;
        await History.AppendAsync("Administrateur",
            [("Module Inventaire", enabled ? "Désactivé" : "Activé", enabled ? "Activé" : "Désactivé")]);
    }

    private async Task OnModuleToggled((string Label, bool Enabled) change)
    {
        if (_modules is null)
        {
            return;
        }

        _modules = await SettingsStore.UpdateSectionAsync<ModulesSettings>("ModulesSettings", modules => modules.Enabled[$"parc:{change.Label}"] = change.Enabled);
        await History.AppendAsync("Administrateur",
            [(change.Label, change.Enabled ? "Désactivé" : "Activé", change.Enabled ? "Activé" : "Désactivé")]);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<ParcSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, T("Configuration enregistrée.")));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, T("Échec de l'enregistrement : {0}", ex.Message)));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
