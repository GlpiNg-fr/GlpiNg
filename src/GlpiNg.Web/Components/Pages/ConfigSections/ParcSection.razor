@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@using GlpiNg.Web.Components.Shared
@inject AppSettingsFileStore SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_modules is null || _model is null)
{
    <p>Chargement…</p>
}
else
{
    <CardExpander Title="Modules" Icon="ti-toggle-left">
        <div class="glpi-module-master-toggle">
            <span class="glpi-module-toggle-label">
                <i class="ti ti-box"></i>
                <span>Module Inventaire</span>
            </span>
            <label class="glpi-switch">
                <input type="checkbox" checked="@_moduleEnabled" @onchange="OnModuleMasterToggled" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <ModuleToggleList GroupKey="parc" Items="ModuleItems" Modules="_modules" OnToggle="OnModuleToggled" Disabled="@(!_moduleEnabled)" />
    </CardExpander>

    <div class="glpi-config-divider">
        <span><i class="ti ti-box"></i> Réglages du parc</span>
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glpi-config-form">
        <div class="glpi-config-field checkbox">
            <label for="parc-infocoms">Activer les informations financières et administratives par défaut</label>
            <label class="glpi-switch">
                <input id="parc-infocoms" type="checkbox" @bind="_model.AutoCreateFinancialInfo" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field">
            <label for="parc-monitors-restrict">Restreindre la gestion des moniteurs</label>
            <select id="parc-monitors-restrict" @bind="_model.MonitorsManagementRestrict">
                <option value="0">Oui - Restreint à la gestion unitaire</option>
                <option value="1">Oui - Restreint à la gestion globale</option>
                <option value="2">Non</option>
            </select>
        </div>

        <div class="glpi-config-field">
            <label for="parc-peripherals-restrict">Restreindre la gestion des périphériques</label>
            <select id="parc-peripherals-restrict" @bind="_model.PeripheralsManagementRestrict">
                <option value="0">Oui - Restreint à la gestion unitaire</option>
                <option value="1">Oui - Restreint à la gestion globale</option>
                <option value="2">Non</option>
            </select>
        </div>

        <div class="glpi-config-field">
            <label for="parc-phones-restrict">Restreindre la gestion des téléphones</label>
            <select id="parc-phones-restrict" @bind="_model.PhonesManagementRestrict">
                <option value="0">Oui - Restreint à la gestion unitaire</option>
                <option value="1">Oui - Restreint à la gestion globale</option>
                <option value="2">Non</option>
            </select>
        </div>

        <div class="glpi-config-field">
            <label for="parc-printers-restrict">Restreindre la gestion des imprimantes</label>
            <select id="parc-printers-restrict" @bind="_model.PrintersManagementRestrict">
                <option value="0">Oui - Restreint à la gestion unitaire</option>
                <option value="1">Oui - Restreint à la gestion globale</option>
                <option value="2">Non</option>
            </select>
        </div>

        <div class="glpi-config-field">
            <label for="parc-autoname">Champs automatiques (marqués par *)</label>
            <select id="parc-autoname" @bind="_model.AutonameScope">
                <option value="0">Global</option>
                <option value="1">Par entité</option>
            </select>
        </div>

        <button type="submit" class="glpi-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private const string SectionName = "ParcSettings";

    public static readonly List<(string Label, string Icon)> ModuleItems =
    [
        ("Moniteurs", "ti-device-tv"),
        ("Logiciels", "ti-apps"),
        ("Matériels réseau", "ti-router"),
        ("Périphériques", "ti-mouse"),
        ("Imprimantes", "ti-printer"),
        ("Cartouches", "ti-droplet"),
        ("Consommables", "ti-package"),
        ("Téléphones", "ti-phone"),
        ("Baies", "ti-server-2"),
        ("Châssis", "ti-layout-grid"),
        ("PDU", "ti-plug"),
        ("Équipements passifs", "ti-plug-connected"),
        ("Actifs non gérés", "ti-help"),
        ("Câbles", "ti-cable"),
        ("Carte SIM éléments", "ti-sim-card"),
        ("Global", "ti-world"),
    ];

    private ModulesSettings? _modules;
    private ParcSettings? _model;
    private bool _moduleEnabled = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
        _model = await SettingsStore.ReadSectionAsync<ParcSettings>(SectionName);
        _moduleEnabled = _modules.IsModuleEnabled("parc");
    }

    private async Task OnModuleMasterToggled(ChangeEventArgs e)
    {
        if (_modules is null)
        {
            return;
        }

        var enabled = (bool)e.Value!;
        _modules.SetModuleEnabled("parc", enabled);
        _moduleEnabled = enabled;
        await SettingsStore.SaveSectionAsync("ModulesSettings", _modules);
        await History.AppendAsync("Administrateur",
            [("Module Inventaire", enabled ? "Désactivé" : "Activé", enabled ? "Activé" : "Désactivé")]);
    }

    private async Task OnModuleToggled((string Label, bool Enabled) change)
    {
        if (_modules is null)
        {
            return;
        }

        _modules.Enabled[$"parc:{change.Label}"] = change.Enabled;
        await SettingsStore.SaveSectionAsync("ModulesSettings", _modules);
        await History.AppendAsync("Administrateur",
            [(change.Label, change.Enabled ? "Désactivé" : "Activé", change.Enabled ? "Activé" : "Désactivé")]);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<ParcSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
