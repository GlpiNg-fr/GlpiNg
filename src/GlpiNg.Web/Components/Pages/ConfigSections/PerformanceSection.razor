@using System.Diagnostics

<p class="hint" style="margin-left:0;">
    GlpiNg tourne sur .NET plutôt que PHP : cet onglet montre donc l'équivalent runtime .NET
    (mémoire gérée, GC, process) là où GLPI affiche l'état d'OPcache et du cache PHP.
</p>

<div class="glpi-diag-card">
    <h4><i class="ti ti-cpu"></i> Runtime .NET</h4>
    <div class="glpi-diag-row"><span>Version</span><strong>@Environment.Version</strong></div>
    <div class="glpi-diag-row"><span>Server GC</span><strong>@(System.Runtime.GCSettings.IsServerGC ? "Oui" : "Non")</strong></div>
    <div class="glpi-diag-row"><span>Processeurs logiques</span><strong>@Environment.ProcessorCount</strong></div>
    <div class="glpi-diag-row"><span>Temps depuis démarrage du process</span><strong>@FormatUptime()</strong></div>
</div>

<div class="glpi-diag-card">
    <h4><i class="ti ti-chart-donut"></i> Mémoire</h4>
    <div class="glpi-diag-row"><span>Working set (process)</span><strong>@FormatMib(_process.WorkingSet64)</strong></div>
    <div class="glpi-diag-row"><span>Tas géré (GC.GetTotalMemory)</span><strong>@FormatMib(GC.GetTotalMemory(false))</strong></div>
    <div class="glpi-diag-row"><span>Collectes Gen0 / Gen1 / Gen2</span><strong>@GC.CollectionCount(0) / @GC.CollectionCount(1) / @GC.CollectionCount(2)</strong></div>
</div>

<div class="glpi-diag-card">
    <h4><i class="ti ti-database"></i> Cache</h4>
    <div class="glpi-diag-row"><span>Réglages (appsettings.json)</span><strong>En mémoire (IMemoryCache), pas de cache distribué configuré</strong></div>
</div>

@code {
    private readonly Process _process = Process.GetCurrentProcess();

    private string FormatUptime()
    {
        var uptime = DateTime.Now - _process.StartTime;
        return $"{(int)uptime.TotalHours}h {uptime.Minutes:D2}min";
    }

    private static string FormatMib(long bytes) => $"{bytes / 1024.0 / 1024.0:0.##} Mio";
}
