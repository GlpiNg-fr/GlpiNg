@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@using GlpiNg.Web.Components.Shared
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_modules is null || _model is null)
{
    <p>Chargement…</p>
}
else
{
    @* L'interrupteur du module est porté par la ligne de titre elle-même : il commande tout ce que
       la carte contient, et reste donc accessible sans la déplier. *@
    <CardExpander Title="Module Gestion" Icon="ti-wallet" Expanded="false">
        <HeaderActions>
            <label class="glpi-switch" title="Activer ou désactiver tout le module Gestion">
                <input type="checkbox" checked="@_moduleEnabled" @onchange="OnModuleMasterToggled" />
                <span class="glpi-switch-slider"></span>
            </label>
        </HeaderActions>
        <ChildContent>
            <ModuleToggleList GroupKey="gestion" Items="ModuleItems" Modules="_modules" OnToggle="OnModuleToggled" Disabled="@(!_moduleEnabled)" />
        </ChildContent>
    </CardExpander>

    <div class="glpi-config-divider">
        <span><i class="ti ti-wallet"></i> Réglages de gestion</span>
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glpi-config-form">
        <div class="glpi-config-field">
            <label for="ge-doc-size">Taille maximale des documents (Mio)</label>
            <input id="ge-doc-size" type="number" min="1" class="glpi-config-input-sm" @bind="_model.DocumentMaxSizeMib" />
        </div>

        <button type="submit" class="glpi-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private const string SectionName = "GestionSettings";

    public static readonly List<(string Label, string Icon)> ModuleItems =
    [
        ("Licences", "ti-license"),
        ("Budgets", "ti-report-money"),
        ("Fournisseurs", "ti-truck"),
        ("Contacts", "ti-address-book"),
        ("Contrats", "ti-file-text"),
        ("Documents", "ti-file"),
        ("Lignes téléphoniques", "ti-phone-call"),
        ("Certificats", "ti-certificate"),
        ("Data centers", "ti-building-warehouse"),
        ("Clusters", "ti-affiliate"),
        ("Domaines", "ti-world-www"),
        ("Applicatifs", "ti-apps"),
        ("Bases de données", "ti-database"),
    ];

    private ModulesSettings? _modules;
    private GestionSettings? _model;
    private bool _moduleEnabled = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
        _model = await SettingsStore.ReadSectionAsync<GestionSettings>(SectionName);
        _moduleEnabled = _modules.IsModuleEnabled("gestion");
    }

    private async Task OnModuleMasterToggled(ChangeEventArgs e)
    {
        if (_modules is null)
        {
            return;
        }

        var enabled = (bool)e.Value!;
        _modules.SetModuleEnabled("gestion", enabled);
        _moduleEnabled = enabled;
        await SettingsStore.SaveSectionAsync("ModulesSettings", _modules);
        await History.AppendAsync("Administrateur",
            [("Module Gestion", enabled ? "Désactivé" : "Activé", enabled ? "Activé" : "Désactivé")]);
    }

    private async Task OnModuleToggled((string Label, bool Enabled) change)
    {
        if (_modules is null)
        {
            return;
        }

        _modules.Enabled[$"gestion:{change.Label}"] = change.Enabled;
        await SettingsStore.SaveSectionAsync("ModulesSettings", _modules);
        await History.AppendAsync("Administrateur",
            [(change.Label, change.Enabled ? "Désactivé" : "Activé", change.Enabled ? "Activé" : "Désactivé")]);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<GestionSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
