@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_model is null)
{
    <p>Chargement…</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glping-config-form">
        <div class="glping-config-divider">
            <span><i class="ti ti-key"></i> Enregistrement</span>
        </div>

        <div class="glping-config-field">
            <label for="net-key">Clé d'enregistrement</label>
            <input id="net-key" @bind="_model.RegistrationKey" placeholder="XXXX-XXXX-XXXX-XXXX" />
        </div>

        <div class="glping-config-divider">
            <span><i class="ti ti-apps"></i> Marketplace</span>
        </div>

        <div class="glping-config-field">
            <label for="net-marketplace">Page des plugins</label>
            <select id="net-marketplace" @bind="_model.MarketplaceBehavior">
                <option value="ask">Demander avant de remplacer</option>
                <option value="replace">Remplacer la page des plugins par celle du Marketplace</option>
                <option value="never">Ne jamais remplacer la page des plugins</option>
            </select>
        </div>

        <button type="submit" class="glping-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private const string SectionName = "GlpiNetworkSettings";

    private GlpiNetworkSettings? _model;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _model = await SettingsStore.ReadSectionAsync<GlpiNetworkSettings>(SectionName);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<GlpiNetworkSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
