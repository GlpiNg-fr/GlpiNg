@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_model is null)
{
    <p>Chargement…</p>
}
else
{
    <p class="hint" style="margin-left:0;">Surcharge des textes du portail libre-service (helpdesk), par langue.</p>

    <div class="glpi-config-field">
        <label for="hd-new-lang">Ajouter une langue</label>
        <div style="display:flex;gap:0.5rem;max-width:520px;">
            <input id="hd-new-lang" @bind="_newLanguageLabel" placeholder="Ex. Español" style="flex:1;" />
            <button type="button" class="glpi-config-save" style="margin:0;" @onclick="AddLanguage">Ajouter</button>
        </div>
    </div>

    @if (_model.Translations.Count == 0)
    {
        <p class="hint" style="margin-left:0;">Aucune langue configurée pour le moment.</p>
    }
    else
    {
        @foreach (var translation in _model.Translations)
        {
            <div class="glpi-config-divider">
                <span><i class="ti ti-language"></i> @translation.LanguageLabel</span>
            </div>

            <div class="glpi-config-field">
                <label>Titre d'accueil</label>
                <input @bind="translation.WelcomeTitle" />
            </div>

            <div class="glpi-config-field">
                <label>Message de bienvenue</label>
                <textarea rows="3" @bind="translation.WelcomeMessage"></textarea>
            </div>

            <div class="glpi-config-field">
                <label>Libellé du bouton d'envoi</label>
                <input @bind="translation.SubmitButtonLabel" />
            </div>

            <div class="glpi-config-field">
                <label></label>
                <button type="button" class="glpi-config-save" style="background:#d63939;" @onclick="() => RemoveLanguage(translation)">Supprimer cette langue</button>
            </div>
        }
    }

    <button type="button" class="glpi-config-save" disabled="@_isSaving" @onclick="SaveAsync">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
}

@code {
    private const string SectionName = "HelpdeskSettings";

    private HelpdeskSettings? _model;
    private bool _isSaving;
    private string _newLanguageLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _model = await SettingsStore.ReadSectionAsync<HelpdeskSettings>(SectionName);
    }

    private void AddLanguage()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_newLanguageLabel))
        {
            return;
        }

        _model.Translations.Add(new HelpdeskTranslation
        {
            LanguageCode = _newLanguageLabel.Trim().ToLowerInvariant().Replace(' ', '_'),
            LanguageLabel = _newLanguageLabel.Trim()
        });
        _newLanguageLabel = string.Empty;
    }

    private void RemoveLanguage(HelpdeskTranslation translation)
    {
        _model?.Translations.Remove(translation);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur",
                [("Helpdesk", "-----", $"{_model.Translations.Count} langue(s) configurée(s)")]);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
