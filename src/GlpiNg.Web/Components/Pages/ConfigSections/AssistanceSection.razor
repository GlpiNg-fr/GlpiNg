@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@using GlpiNg.Web.Components.Shared
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService
@implements IDisposable

@if (_modules is null || _model is null)
{
    <p>@T("Chargement…")</p>
}
else
{
    @* L'interrupteur du module est porté par la ligne de titre elle-même : il commande tout ce que
       la carte contient, et reste donc accessible sans la déplier. *@
    <CardExpander Title="@(T("Module Assistance"))" Icon="ti-headset" Expanded="false">
        <HeaderActions>
            <label class="glping-switch" title="@(T("Activer ou désactiver tout le module Assistance"))">
                <input type="checkbox" checked="@_moduleEnabled" @onchange="OnModuleMasterToggled" />
                <span class="glping-switch-slider"></span>
            </label>
        </HeaderActions>
        <ChildContent>
            <ModuleToggleList GroupKey="assistance" Items="ModuleItems" Modules="_modules" OnToggle="OnModuleToggled" Disabled="@(!_moduleEnabled)" />
        </ChildContent>
    </CardExpander>

    <div class="glping-config-divider">
        <span><i class="ti ti-headset"></i> @T("Réglages de l'assistance")</span>
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glping-config-form">
        <div class="glping-config-field">
            <label for="as-time-step">@T("Pas pour les heures (en minutes)")</label>
            <select id="as-time-step" class="glping-config-input-sm" @bind="_model.TimeStepMinutes">
                <option value="1">1</option>
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="30">30</option>
                <option value="60">60</option>
            </select>
        </div>

        <div class="glping-config-field">
            <label for="as-planning-begin">@T("Début du planning")</label>
            <input id="as-planning-begin" type="text" placeholder="@(T("HH:mm"))" pattern="[0-2][0-9]:[0-5][0-9]" class="glping-config-input-sm" @bind="_model.PlanningBegin" />
        </div>

        <div class="glping-config-field">
            <label for="as-planning-end">@T("Fin du planning")</label>
            <input id="as-planning-end" type="text" placeholder="@(T("HH:mm"))" pattern="[0-2][0-9]:[0-5][0-9]" class="glping-config-input-sm" @bind="_model.PlanningEnd" />
        </div>

        <div class="glping-config-field">
            <label>@T("Planification des journées ouvrées")</label>
            <div class="glping-switch-grid" style="margin:0;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));">
                @foreach (var day in WorkDays)
                {
                    var inputId = $"as-workday-{day.Value}";
                    <div class="glping-switch-grid-item">
                        <label class="glping-switch">
                            <input id="@inputId" type="checkbox" checked="@_model.PlanningWorkDays.Contains(day.Value)" @onchange="e => ToggleWorkDay(day.Value, (bool)e.Value!)" />
                            <span class="glping-switch-slider"></span>
                        </label>
                        <label for="@inputId">@T(day.Label)</label>
                    </div>
                }
            </div>
        </div>

        <div class="glping-config-field">
            <label for="as-mailcollector-size">@T("Taille max. des pièces jointes du collecteur de mails")</label>
            <select id="as-mailcollector-size" @bind="_model.MailCollectorMaxFileSize">
                <option value="0">@T("Pas d'import")</option>
                <option value="1048576">@T("1 Mio")</option>
                <option value="2097152">@T("2 Mio")</option>
                <option value="5242880">@T("5 Mio")</option>
                <option value="10485760">@T("10 Mio")</option>
                <option value="20971520">@T("20 Mio")</option>
                <option value="52428800">@T("50 Mio")</option>
                <option value="104857600">@T("100 Mio")</option>
            </select>
        </div>

        <div class="glping-config-field checkbox">
            <label for="as-software-linkable">@T("Par défaut, un logiciel peut être associé à un ticket")</label>
            <label class="glping-switch">
                <input id="as-software-linkable" type="checkbox" @bind="_model.SoftwareLinkableToTicketByDefault" />
                <span class="glping-switch-slider"></span>
            </label>
        </div>

        <div class="glping-config-field checkbox">
            <label for="as-keep-tickets">@T("Conserver les tickets à la purge d'un élément de l'inventaire")</label>
            <label class="glping-switch">
                <input id="as-keep-tickets" type="checkbox" @bind="_model.KeepTicketsOnAssetPurge" />
                <span class="glping-switch-slider"></span>
            </label>
        </div>

        <div class="glping-config-field checkbox">
            <label for="as-show-personal">@T("Afficher les informations personnelles dans le formulaire de nouveau ticket (interface simplifiée)")</label>
            <label class="glping-switch">
                <input id="as-show-personal" type="checkbox" @bind="_model.ShowPersonalInfoOnSimplifiedTicketForm" />
                <span class="glping-switch-slider"></span>
            </label>
        </div>

        <div class="glping-config-field checkbox">
            <label for="as-anon-tickets">@T("Autoriser les ouvertures de tickets anonymes (collecteur)")</label>
            <label class="glping-switch">
                <input id="as-anon-tickets" type="checkbox" @bind="_model.AllowAnonymousTicketCreation" />
                <span class="glping-switch-slider"></span>
            </label>
        </div>

        <div class="glping-config-field checkbox">
            <label for="as-anon-followups">@T("Autoriser les suivis anonymes (collecteur)")</label>
            <label class="glping-switch">
                <input id="as-anon-followups" type="checkbox" @bind="_model.AllowAnonymousFollowups" />
                <span class="glping-switch-slider"></span>
            </label>
        </div>

        <div class="glping-config-divider">
            <span><i class="ti ti-flag"></i> @T("Matrice de priorité")</span>
        </div>

        <p class="hint" style="margin-left:0;">@T("Priorité = f(urgence, impact). Cliquez sur les niveaux pour les activer/désactiver (le niveau \"Moyenne\" reste toujours actif).")</p>

        <div style="overflow-x:auto;">
            <table class="glping-priority-matrix">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var impact in Levels)
                        {
                            <th>
                                @if (impact.Value == 3)
                                {
                                    <span>@T(impact.Label)</span>
                                }
                                else
                                {
                                    <label style="display:flex;flex-direction:column;align-items:center;gap:0.2rem;cursor:pointer;">
                                        <input type="checkbox" checked="@_model.EnabledImpactLevels.Contains(impact.Value)" @onchange="e => ToggleLevel(_model.EnabledImpactLevels, impact.Value, (bool)e.Value!)" />
                                        @T(impact.Label)
                                    </label>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var urgency in Levels)
                    {
                        <tr>
                            <th>
                                @if (urgency.Value == 3)
                                {
                                    <span>@T(urgency.Label)</span>
                                }
                                else
                                {
                                    <label style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
                                        <input type="checkbox" checked="@_model.EnabledUrgencyLevels.Contains(urgency.Value)" @onchange="e => ToggleLevel(_model.EnabledUrgencyLevels, urgency.Value, (bool)e.Value!)" />
                                        @T(urgency.Label)
                                    </label>
                                }
                            </th>
                            @foreach (var impact in Levels)
                            {
                                var key = $"{urgency.Value}_{impact.Value}";
                                var priority = _model.PriorityMatrix.GetValueOrDefault(key, 3);
                                <td class="glping-priority-@priority">
                                    <select @bind="_model.PriorityMatrix[key]">
                                        @foreach (var p in Levels)
                                        {
                                            <option value="@p.Value">@T(p.Label)</option>
                                        }
                                    </select>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="glping-config-save" disabled="@_isSaving">@(_isSaving ? T("Enregistrement…") : T("Enregistrer"))</button>
    </EditForm>
}

@code {
    private const string SectionName = "AssistanceSettings";

    public static readonly List<(string Label, string Icon)> ModuleItems =
    [
        ("Tickets", "ti-ticket"),
        ("Problèmes", "ti-alert-triangle"),
        ("Changements", "ti-replace"),
        ("Planning", "ti-calendar"),
        ("Statistiques", "ti-chart-bar"),
    ];

    private static readonly List<(int Value, string Label)> Levels =
    [
        (1, "Très basse"), (2, "Basse"), (3, "Moyenne"), (4, "Haute"), (5, "Très haute"),
    ];

    private static readonly List<(int Value, string Label)> WorkDays =
    [
        (1, "Lundi"), (2, "Mardi"), (3, "Mercredi"), (4, "Jeudi"), (5, "Vendredi"), (6, "Samedi"), (0, "Dimanche"),
    ];

    private ModulesSettings? _modules;
    private AssistanceSettings? _model;
    private bool _moduleEnabled = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
        _model = await SettingsStore.ReadSectionAsync<AssistanceSettings>(SectionName);
        _moduleEnabled = _modules.IsModuleEnabled("assistance");
        SettingsStore.SectionSaved += OnSettingsSectionSaved;
    }

    /// <summary>
    /// Un autre écran — ou un autre administrateur — vient de basculer un module : les interrupteurs
    /// de cette carte reprennent la valeur enregistrée, comme le menu latéral de chacun.
    /// </summary>
    private void OnSettingsSectionSaved(string sectionName)
    {
        if (sectionName != "ModulesSettings")
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
            _moduleEnabled = _modules.IsModuleEnabled("assistance");
            StateHasChanged();
        });
    }

    public void Dispose() => SettingsStore.SectionSaved -= OnSettingsSectionSaved;

    private async Task OnModuleMasterToggled(ChangeEventArgs e)
    {
        if (_modules is null)
        {
            return;
        }

        var enabled = (bool)e.Value!;
        _modules = await SettingsStore.UpdateSectionAsync<ModulesSettings>("ModulesSettings", modules => modules.SetModuleEnabled("assistance", enabled));
        _moduleEnabled = enabled;
        await History.AppendAsync("Administrateur",
            [("Module Assistance", enabled ? "Désactivé" : "Activé", enabled ? "Activé" : "Désactivé")]);
    }

    private void ToggleWorkDay(int day, bool enabled)
    {
        if (_model is null)
        {
            return;
        }

        if (enabled && !_model.PlanningWorkDays.Contains(day))
        {
            _model.PlanningWorkDays.Add(day);
        }
        else if (!enabled)
        {
            _model.PlanningWorkDays.Remove(day);
        }
    }

    private void ToggleLevel(List<int> levels, int value, bool enabled)
    {
        if (enabled && !levels.Contains(value))
        {
            levels.Add(value);
        }
        else if (!enabled && value != 3)
        {
            levels.Remove(value);
        }
    }

    private async Task OnModuleToggled((string Label, bool Enabled) change)
    {
        if (_modules is null)
        {
            return;
        }

        _modules = await SettingsStore.UpdateSectionAsync<ModulesSettings>("ModulesSettings", modules => modules.Enabled[$"assistance:{change.Label}"] = change.Enabled);
        await History.AppendAsync("Administrateur",
            [(change.Label, change.Enabled ? "Désactivé" : "Activé", change.Enabled ? "Activé" : "Désactivé")]);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<AssistanceSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, T("Configuration enregistrée.")));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, T("Échec de l'enregistrement : {0}", ex.Message)));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
