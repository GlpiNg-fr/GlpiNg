@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@using GlpiNg.Web.Components.Shared
@inject SettingsCacheService SettingsStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_modules is null || _model is null)
{
    <p>Chargement…</p>
}
else
{
    @* L'interrupteur du module est porté par la ligne de titre elle-même : il commande tout ce que
       la carte contient, et reste donc accessible sans la déplier. *@
    <CardExpander Title="Module Assistance" Icon="ti-headset" Expanded="false">
        <HeaderActions>
            <label class="glpi-switch" title="Activer ou désactiver tout le module Assistance">
                <input type="checkbox" checked="@_moduleEnabled" @onchange="OnModuleMasterToggled" />
                <span class="glpi-switch-slider"></span>
            </label>
        </HeaderActions>
        <ChildContent>
            <ModuleToggleList GroupKey="assistance" Items="ModuleItems" Modules="_modules" OnToggle="OnModuleToggled" Disabled="@(!_moduleEnabled)" />
        </ChildContent>
    </CardExpander>

    <div class="glpi-config-divider">
        <span><i class="ti ti-headset"></i> Réglages de l'assistance</span>
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glpi-config-form">
        <div class="glpi-config-field">
            <label for="as-time-step">Pas pour les heures (en minutes)</label>
            <select id="as-time-step" class="glpi-config-input-sm" @bind="_model.TimeStepMinutes">
                <option value="1">1</option>
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="30">30</option>
                <option value="60">60</option>
            </select>
        </div>

        <div class="glpi-config-field">
            <label for="as-planning-begin">Début du planning</label>
            <input id="as-planning-begin" type="text" placeholder="HH:mm" pattern="[0-2][0-9]:[0-5][0-9]" class="glpi-config-input-sm" @bind="_model.PlanningBegin" />
        </div>

        <div class="glpi-config-field">
            <label for="as-planning-end">Fin du planning</label>
            <input id="as-planning-end" type="text" placeholder="HH:mm" pattern="[0-2][0-9]:[0-5][0-9]" class="glpi-config-input-sm" @bind="_model.PlanningEnd" />
        </div>

        <div class="glpi-config-field">
            <label>Planification des journées ouvrées</label>
            <div class="glpi-switch-grid" style="margin:0;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));">
                @foreach (var day in WorkDays)
                {
                    var inputId = $"as-workday-{day.Value}";
                    <div class="glpi-switch-grid-item">
                        <label class="glpi-switch">
                            <input id="@inputId" type="checkbox" checked="@_model.PlanningWorkDays.Contains(day.Value)" @onchange="e => ToggleWorkDay(day.Value, (bool)e.Value!)" />
                            <span class="glpi-switch-slider"></span>
                        </label>
                        <label for="@inputId">@day.Label</label>
                    </div>
                }
            </div>
        </div>

        <div class="glpi-config-field">
            <label for="as-mailcollector-size">Taille max. des pièces jointes du collecteur de mails</label>
            <select id="as-mailcollector-size" @bind="_model.MailCollectorMaxFileSize">
                <option value="0">Pas d'import</option>
                <option value="1048576">1 Mio</option>
                <option value="2097152">2 Mio</option>
                <option value="5242880">5 Mio</option>
                <option value="10485760">10 Mio</option>
                <option value="20971520">20 Mio</option>
                <option value="52428800">50 Mio</option>
                <option value="104857600">100 Mio</option>
            </select>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="as-software-linkable">Par défaut, un logiciel peut être associé à un ticket</label>
            <label class="glpi-switch">
                <input id="as-software-linkable" type="checkbox" @bind="_model.SoftwareLinkableToTicketByDefault" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="as-keep-tickets">Conserver les tickets à la purge d'un élément de l'inventaire</label>
            <label class="glpi-switch">
                <input id="as-keep-tickets" type="checkbox" @bind="_model.KeepTicketsOnAssetPurge" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="as-show-personal">Afficher les informations personnelles dans le formulaire de nouveau ticket (interface simplifiée)</label>
            <label class="glpi-switch">
                <input id="as-show-personal" type="checkbox" @bind="_model.ShowPersonalInfoOnSimplifiedTicketForm" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="as-anon-tickets">Autoriser les ouvertures de tickets anonymes (collecteur)</label>
            <label class="glpi-switch">
                <input id="as-anon-tickets" type="checkbox" @bind="_model.AllowAnonymousTicketCreation" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="as-anon-followups">Autoriser les suivis anonymes (collecteur)</label>
            <label class="glpi-switch">
                <input id="as-anon-followups" type="checkbox" @bind="_model.AllowAnonymousFollowups" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-divider">
            <span><i class="ti ti-flag"></i> Matrice de priorité</span>
        </div>

        <p class="hint" style="margin-left:0;">Priorité = f(urgence, impact). Cliquez sur les niveaux pour les activer/désactiver (le niveau "Moyenne" reste toujours actif).</p>

        <div style="overflow-x:auto;">
            <table class="glpi-priority-matrix">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var impact in Levels)
                        {
                            <th>
                                @if (impact.Value == 3)
                                {
                                    <span>@impact.Label</span>
                                }
                                else
                                {
                                    <label style="display:flex;flex-direction:column;align-items:center;gap:0.2rem;cursor:pointer;">
                                        <input type="checkbox" checked="@_model.EnabledImpactLevels.Contains(impact.Value)" @onchange="e => ToggleLevel(_model.EnabledImpactLevels, impact.Value, (bool)e.Value!)" />
                                        @impact.Label
                                    </label>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var urgency in Levels)
                    {
                        <tr>
                            <th>
                                @if (urgency.Value == 3)
                                {
                                    <span>@urgency.Label</span>
                                }
                                else
                                {
                                    <label style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
                                        <input type="checkbox" checked="@_model.EnabledUrgencyLevels.Contains(urgency.Value)" @onchange="e => ToggleLevel(_model.EnabledUrgencyLevels, urgency.Value, (bool)e.Value!)" />
                                        @urgency.Label
                                    </label>
                                }
                            </th>
                            @foreach (var impact in Levels)
                            {
                                var key = $"{urgency.Value}_{impact.Value}";
                                var priority = _model.PriorityMatrix.GetValueOrDefault(key, 3);
                                <td class="glpi-priority-@priority">
                                    <select @bind="_model.PriorityMatrix[key]">
                                        @foreach (var p in Levels)
                                        {
                                            <option value="@p.Value">@p.Label</option>
                                        }
                                    </select>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="glpi-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private const string SectionName = "AssistanceSettings";

    public static readonly List<(string Label, string Icon)> ModuleItems =
    [
        ("Tickets", "ti-ticket"),
        ("Problèmes", "ti-alert-triangle"),
        ("Changements", "ti-replace"),
        ("Planning", "ti-calendar"),
        ("Statistiques", "ti-chart-bar"),
    ];

    private static readonly List<(int Value, string Label)> Levels =
    [
        (1, "Très basse"), (2, "Basse"), (3, "Moyenne"), (4, "Haute"), (5, "Très haute"),
    ];

    private static readonly List<(int Value, string Label)> WorkDays =
    [
        (1, "Lundi"), (2, "Mardi"), (3, "Mercredi"), (4, "Jeudi"), (5, "Vendredi"), (6, "Samedi"), (0, "Dimanche"),
    ];

    private ModulesSettings? _modules;
    private AssistanceSettings? _model;
    private bool _moduleEnabled = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _modules = await SettingsStore.ReadSectionAsync<ModulesSettings>("ModulesSettings");
        _model = await SettingsStore.ReadSectionAsync<AssistanceSettings>(SectionName);
        _moduleEnabled = _modules.IsModuleEnabled("assistance");
    }

    private async Task OnModuleMasterToggled(ChangeEventArgs e)
    {
        if (_modules is null)
        {
            return;
        }

        var enabled = (bool)e.Value!;
        _modules.SetModuleEnabled("assistance", enabled);
        _moduleEnabled = enabled;
        await SettingsStore.SaveSectionAsync("ModulesSettings", _modules);
        await History.AppendAsync("Administrateur",
            [("Module Assistance", enabled ? "Désactivé" : "Activé", enabled ? "Activé" : "Désactivé")]);
    }

    private void ToggleWorkDay(int day, bool enabled)
    {
        if (_model is null)
        {
            return;
        }

        if (enabled && !_model.PlanningWorkDays.Contains(day))
        {
            _model.PlanningWorkDays.Add(day);
        }
        else if (!enabled)
        {
            _model.PlanningWorkDays.Remove(day);
        }
    }

    private void ToggleLevel(List<int> levels, int value, bool enabled)
    {
        if (enabled && !levels.Contains(value))
        {
            levels.Add(value);
        }
        else if (!enabled && value != 3)
        {
            levels.Remove(value);
        }
    }

    private async Task OnModuleToggled((string Label, bool Enabled) change)
    {
        if (_modules is null)
        {
            return;
        }

        _modules.Enabled[$"assistance:{change.Label}"] = change.Enabled;
        await SettingsStore.SaveSectionAsync("ModulesSettings", _modules);
        await History.AppendAsync("Administrateur",
            [(change.Label, change.Enabled ? "Désactivé" : "Activé", change.Enabled ? "Activé" : "Désactivé")]);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<AssistanceSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
