@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject ConfigHistoryService History

@if (_entries is null)
{
    <p>@T("Chargement…")</p>
}
else if (_entries.Count == 0)
{
    <p class="hint" style="margin-left:0;">
        @T("Aucune entrée pour le moment : cet historique s'alimente à chaque enregistrement effectué depuis les autres onglets de cette page.")
    </p>
}
else
{
    <div class="glping-config-table-wrap" style="max-width:100%;">
        <table class="glping-config-table">
            <thead>
                <tr>
                    <th>@T("ID")</th>
                    <th>@T("Date")</th>
                    <th>@T("Utilisateur")</th>
                    <th>@T("Champ")</th>
                    <th>@T("Mise à jour")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>@entry.Id</td>
                        <td>@Display.DateTime(entry.Date.UtcDateTime)</td>
                        <td>@entry.User</td>
                        <td>@entry.Field</td>
                        <td>@entry.Update</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<HistoryEntry>? _entries;

    protected override async Task OnInitializedAsync()
    {
        _entries = await History.ReadAllAsync();
    }
}
