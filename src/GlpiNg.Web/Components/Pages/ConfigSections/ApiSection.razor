@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject SettingsCacheService SettingsStore
@inject AppSettingsFileStore FileStore
@inject ConfigHistoryService History
@inject ToastService ToastService

@if (_model is null || _server is null)
{
    <p>Chargement…</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glpi-config-form">
        <div class="glpi-config-field checkbox">
            <label for="api-hlapi">Activer l'API</label>
            <label class="glpi-switch">
                <input id="api-hlapi" type="checkbox" @bind="_model.EnableHighLevelApi" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="api-legacy">Activer l'API REST legacy</label>
            <label class="glpi-switch">
                <input id="api-legacy" type="checkbox" @bind="_model.EnableLegacyRestApi" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="swagger">Activer Swagger (/swagger)</label>
            <label class="glpi-switch">
                <input id="swagger" type="checkbox" @bind="_server.SwaggerEnabled" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>
        <p class="hint">Pris en compte immédiatement, sans redémarrage.</p>

        <div class="glpi-config-field">
            <label for="api-url">URL de l'API</label>
            <input id="api-url" @bind="_model.LegacyApiUrl" />
        </div>
        <p class="hint">
            GlpiNg expose déjà sa propre API REST (voir <code>/swagger</code> ci-dessus) : ces
            réglages ne font que documenter des équivalents GLPI, ils ne pilotent pas encore ce
            endpoint.
        </p>

        <div class="glpi-config-field checkbox">
            <label for="api-login-creds">Activer la connexion avec identifiants</label>
            <label class="glpi-switch">
                <input id="api-login-creds" type="checkbox" @bind="_model.EnableLoginWithCredentials" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <div class="glpi-config-field checkbox">
            <label for="api-login-token">Activer la connexion avec un jeton externe</label>
            <label class="glpi-switch">
                <input id="api-login-token" type="checkbox" @bind="_model.EnableLoginWithExternalToken" />
                <span class="glpi-switch-slider"></span>
            </label>
        </div>

        <button type="submit" class="glpi-config-save" disabled="@_isSaving">@(_isSaving ? "Enregistrement…" : "Enregistrer")</button>
    </EditForm>
}

@code {
    private const string SectionName = "ApiSettings";

    private ApiSettings? _model;
    private ServerSettings? _server;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _model = await SettingsStore.ReadSectionAsync<ApiSettings>(SectionName);
        _server = await FileStore.ReadAsync();
    }

    private async Task SaveAsync()
    {
        if (_model is null || _server is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var before = await SettingsStore.ReadSectionAsync<ApiSettings>(SectionName);
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            await FileStore.SaveAsync(_server);
            await History.AppendAsync("Administrateur", SettingsDiff.Compare(before, _model));
            ToastService.Notify(new ToastMessage(ToastType.Success, "Configuration enregistrée."));
        }
        catch (IOException ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Échec de l'enregistrement : {ex.Message}"));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
