<div class="card mb-3">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" style="border-bottom: none;">
            <li class="nav-item">
                <a href="/authentication/config" class="nav-link @(Current == "config" ? "active" : "")">
                    <i class="ti ti-settings me-1"></i>Configuration
                </a>
            </li>
            <li class="nav-item">
                <a href="/authentication/ldap" class="nav-link @(Current == "ldap" ? "active" : "")">
                    <i class="ti ti-address-book me-1"></i>Annuaire LDAP
                </a>
            </li>
            <li class="nav-item">
                <a href="/authentication/mail" class="nav-link @(Current == "mail" ? "active" : "")">
                    <i class="ti ti-mail me-1"></i>Serveur mails
                </a>
            </li>
            <li class="nav-item">
                <a href="/authentication/others" class="nav-link @(Current == "others" ? "active" : "")">
                    <i class="ti ti-key me-1"></i>Autres méthodes d'authentification
                </a>
            </li>
        </ul>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Current { get; set; } = string.Empty;
}
