@page "/config/auth/config"
@using GlpiNg.Web.Models
@using GlpiNg.Web.Services
@inject SettingsCacheService SettingsStore
@inject ToastService ToastService
@rendermode InteractiveServer

<PageTitle>@T("Authentification — GlpiNg")</PageTitle>

<AuthTabStrip Current="config" />

@if (_model is null)
{
    <p>@T("Chargement…")</p>
}
else
{
    <div class="glping-config">
        <div class="glping-config-body">
            <EditForm Model="_model" OnValidSubmit="SaveAsync" class="glping-config-form">
                <div class="glping-config-field checkbox">
                    <label for="auth-auto-add">@T("Ajout automatique des utilisateurs à partir des sources externes d'authentification")</label>
                    <label class="glping-switch">
                        <input id="auth-auto-add" type="checkbox" @bind="_model.AutoAddUsersFromExternalAuth" />
                        <span class="glping-switch-slider"></span>
                    </label>
                </div>

                <div class="glping-config-field checkbox">
                    <label for="auth-add-without-right">@T("Ajouter un utilisateur sans habilitation depuis un annuaire LDAP")</label>
                    <label class="glping-switch">
                        <input id="auth-add-without-right" type="checkbox" @bind="_model.AddUserWithoutRightFromLdap" />
                        <span class="glping-switch-slider"></span>
                    </label>
                </div>

                <div class="glping-config-field">
                    <label for="auth-restored">@T("Action quand un utilisateur est restauré dans l'annuaire LDAP")</label>
                    <select id="auth-restored" @bind="_model.RestoredUserAction">
                        @foreach (LdapUserPresenceAction action in Enum.GetValues<LdapUserPresenceAction>())
                        {
                            <option value="@action">@ActionLabel(action)</option>
                        }
                    </select>
                </div>

                <div class="glping-fiche-block-title mt-3"><i class="ti ti-user-x"></i>@T("Action lorsqu'un utilisateur est supprimé de l'annuaire LDAP")</div>

                <div class="glping-config-field">
                    <label for="auth-deleted-user">@T("Utilisateur")</label>
                    <select id="auth-deleted-user" @bind="_model.DeletedUserAction">
                        @foreach (LdapUserPresenceAction action in Enum.GetValues<LdapUserPresenceAction>())
                        {
                            <option value="@action">@ActionLabel(action)</option>
                        }
                    </select>
                </div>

                <div class="glping-config-field">
                    <label for="auth-deleted-groups">@T("Groupes")</label>
                    <select id="auth-deleted-groups" @bind="_model.DeletedUserGroupsAction">
                        @foreach (LdapUserPresenceAction action in Enum.GetValues<LdapUserPresenceAction>())
                        {
                            <option value="@action">@ActionLabel(action)</option>
                        }
                    </select>
                </div>

                <div class="glping-config-field">
                    <label for="auth-deleted-hab">@T("Habilitations")</label>
                    <select id="auth-deleted-hab" @bind="_model.DeletedUserHabilitationsAction">
                        @foreach (LdapUserPresenceAction action in Enum.GetValues<LdapUserPresenceAction>())
                        {
                            <option value="@action">@ActionLabel(action)</option>
                        }
                    </select>
                </div>

                <p class="hint mt-3">
                    @T("Seul « Ajout automatique des utilisateurs » est aujourd'hui appliqué (voir AccountController.Login) : les autres réglages ci-dessus sont conservés pour la fidélité avec GLPI mais ne pilotent aucune synchronisation — GlpiNg n'a pas de tâche planifiée de synchronisation LDAP.")
                </p>

                <button type="submit" class="glping-config-save" disabled="@_isSaving">@(_isSaving ? T("Enregistrement…") : T("Enregistrer"))</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private const string SectionName = "AuthSettings";

    private AuthSettings? _model;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _model = await SettingsStore.ReadSectionAsync<AuthSettings>(SectionName);
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _isSaving = true;

        try
        {
            await SettingsStore.SaveSectionAsync(SectionName, _model);
            ToastService.Notify(new ToastMessage(ToastType.Success, T("Configuration enregistrée.")));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string ActionLabel(LdapUserPresenceAction action) => action switch
    {
        LdapUserPresenceAction.DoNothing => T("Ne rien faire"),
        LdapUserPresenceAction.Restore => T("Restaurer"),
        LdapUserPresenceAction.MoveToTrash => T("Mettre en corbeille"),
        LdapUserPresenceAction.Delete => T("Supprimer"),
        LdapUserPresenceAction.Deactivate => T("Désactiver"),
        _ => action.ToString(),
    };
}
