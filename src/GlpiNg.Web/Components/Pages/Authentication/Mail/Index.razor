@page "/authentication/mail"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>GlpiNg — Serveurs mails</PageTitle>

<AuthTabStrip Current="mail" />

<div class="page-header d-flex align-items-center justify-content-between mb-3">
    <h2 class="page-title mb-0">Serveurs mails</h2>
    <div class="text-secondary">@_filteredServers.Count résultat(s)</div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Rechercher un serveur..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <label class="form-check m-0 px-2" title="Tout sélectionner">
                <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                       @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
            </label>

            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count serveur(s) sélectionné(s) ? Cette action est définitive.</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="OnRefreshAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newMailServerModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;"></th>
                    <th>Nom</th>
                    <th>Serveur</th>
                    <th>Protocole</th>
                    <th>Par défaut</th>
                    <th>Activé</th>
                </tr>
            </thead>
            <tbody>
                @if (_filteredServers.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">Aucun serveur mail configuré.</td>
                    </tr>
                }
                else
                {
                    @foreach (AuthMailServer server in _filteredServers)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(server.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(server.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/authentication/mail/{server.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-mail me-1 text-secondary"></i>@server.Name
                                </a>
                            </td>
                            <td>@server.Host@(server.Port is { } port ? $":{port}" : "")</td>
                            <td>@(server.Protocol == MailServerProtocol.Imap ? "IMAP" : "POP")</td>
                            <td>@(server.IsDefault ? "Oui" : "Non")</td>
                            <td>@(server.IsActive ? "Oui" : "Non")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="newMailServerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-mail me-2"></i>Nouvel élément - Serveur mails</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <MailServerFormFields Server="_newServer" OnChanged="StateHasChanged" />
                @if (_createError is not null)
                {
                    <p class="status mt-2">@_createError</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@(!CanCreate)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
