@page "/config/auth/mail/{ServerId:int}"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>@(_server?.Name ?? "Serveur mails") — GlpiNg</PageTitle>

<AuthTabStrip Current="mail" />

@if (_server is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-mail fs-1"></i>
        <p class="mt-2">Ce serveur est introuvable.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <i class="ti ti-mail me-2"></i>
            <span class="fw-semibold">Serveur mails - @_server.Name - ID @_server.Id</span>
        </div>
        <div class="card-body">
            <EditForm Model="_server" OnValidSubmit="SaveAsync">
                <MailServerFormFields Server="_server" />

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                        <i class="ti ti-trash me-1"></i>Supprimer définitivement
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                        <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
