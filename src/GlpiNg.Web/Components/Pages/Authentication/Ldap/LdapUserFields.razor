@using GlpiNg.Web.Models

@* Onglet « Utilisateurs » de la fiche annuaire : correspondance entre les attributs LDAP et les
   champs d'un compte GlpiNg. Ces valeurs ne sont pas décoratives — elles décident des attributs
   demandés au serveur pendant la recherche, et sont réappliquées à chaque connexion (voir
   UserCredentialAuthenticator.ApplyLdapAttributes). Un champ laissé vide n'est simplement pas lu. *@

<p class="text-secondary">
    @T("Attributs de l'annuaire recopiés sur le compte à chaque connexion. Laisser un champ vide pour ne pas reprendre l'information correspondante.")
</p>

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Champ de l'identifiant")</label>
            <input class="form-control" @bind="Server.LoginField" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Filtre de connexion (optionnel)")</label>
            <textarea class="form-control" rows="2" @bind="Server.LoginFilter"
                      placeholder="@(T("(memberOf=cn=glping-users,ou=groups,dc=example,dc=com)"))"></textarea>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Champ de synchronisation (optionnel)")</label>
            <input class="form-control" @bind="Server.SyncField" placeholder="@(T("objectguid"))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Nom de famille")</label>
            <input class="form-control" @bind="Server.LastNameField" placeholder="@(T("sn"))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Prénom")</label>
            <input class="form-control" @bind="Server.FirstNameField" placeholder="@(T("givenname"))" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom affiché")</label>
            <input class="form-control" @bind="Server.DisplayNameField" placeholder="@(T("displayname"))" />
            <div class="form-hint">@T("Vide : reconstitué à partir du prénom et du nom.")</div>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Courriel")</label>
            <input class="form-control" @bind="Server.EmailField" placeholder="@(T("mail"))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Téléphone")</label>
            <input class="form-control" @bind="Server.PhoneField" placeholder="@(T("telephonenumber"))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Téléphone mobile")</label>
            <input class="form-control" @bind="Server.MobileField" placeholder="@(T("mobile"))" />
            <div class="form-hint">@T("Utilisé si le téléphone fixe est absent.")</div>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Localisation")</label>
            <input class="form-control" @bind="Server.LocationField" placeholder="@(T("physicaldeliveryofficename"))" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Titre")</label>
            <input class="form-control" @bind="Server.TitleField" placeholder="@(T("title"))" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <input class="form-control" @bind="Server.CommentField" placeholder="@(T("description"))" />
        </div>
    </div>
</div>

<p class="hint">
    @T("Titre et commentaires sont lus depuis l'annuaire mais n'ont pas encore de champ correspondant sur la fiche utilisateur : ils sont conservés ici pour ne pas avoir à les ressaisir le jour où ces champs existeront.")
</p>

@code {
    [Parameter, EditorRequired]
    public AuthLdapServer Server { get; set; } = null!;
}
