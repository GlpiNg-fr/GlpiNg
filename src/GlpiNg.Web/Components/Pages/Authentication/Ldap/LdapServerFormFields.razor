@using GlpiNg.Web.Models

@* Connexion a l'annuaire : ce qu'il faut pour joindre le serveur et s'y authentifier. La
   correspondance des attributs, les groupes et les reglages avances vivent dans les onglets
   dedies de la fiche (voir Detail.razor) - ce composant sert aussi a la creation depuis la
   liste, ou seuls ces champs-la sont demandes. *@

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom")</label>
            <input class="form-control" @bind="Server.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Serveur par défaut")</label>
            @YesNoSelect(Server.IsDefault, v => Server.IsDefault = v)
        </div>
        <div class="glping-fiche-field">
            <label>@T("Activé")</label>
            @YesNoSelect(Server.IsActive, v => Server.IsActive = v)
        </div>
        <div class="glping-fiche-field">
            <label>@T("Serveur")</label>
            <input class="form-control" @bind="Server.Host" @bind:event="oninput" @bind:after="NotifyChangedAsync" placeholder="ldap.example.com" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Port (par défaut 389)")</label>
            <input type="number" class="form-control" @bind="Server.Port" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("SSL/TLS")</label>
            @YesNoSelect(Server.UseSsl, v => Server.UseSsl = v)
        </div>
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <textarea class="form-control" rows="2" @bind="Server.Comment"></textarea>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("BaseDN")</label>
            <input class="form-control" @bind="Server.BaseDn" @bind:event="oninput" @bind:after="NotifyChangedAsync" placeholder="@(T("dc=example,dc=com"))" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Utiliser un compte de connexion (bind)")</label>
            @YesNoSelect(Server.UseBind, v => Server.UseBind = v)
        </div>
        @if (Server.UseBind)
        {
            <div class="glping-fiche-field">
                <label>@T("DN du compte (pour les connexions non anonymes)")</label>
                <input class="form-control" @bind="Server.BindDn" placeholder="@(T("cn=admin,dc=example,dc=com"))" />
            </div>
            <div class="glping-fiche-field">
                <label>@T("Mot de passe du compte")</label>
                <input type="password" class="form-control" value="@BindPasswordPlain" @oninput="OnPasswordInput"
                       placeholder="@(HasStoredPassword ? T("•••••••• (laisser vide pour conserver)") : "")" />
                @* Un secret present mais indechiffrable affichait le meme « •••••••• » qu'un secret
                   valide. Le bind degenerait alors en bind non authentifie, sans que rien ne le
                   laisse voir sur cette fiche. *@
                @if (StoredPasswordUnreadable)
                {
                    <div class="form-hint text-danger">
                        <i class="ti ti-alert-triangle me-1"></i>
                        @T("Un mot de passe est enregistré mais ne peut plus être déchiffré : les clés de chiffrement ont changé, ou l'application a été déplacée ou lancée sous un autre compte. Ressaisissez-le — sans lui, la connexion à l'annuaire reste anonyme.")
                    </div>
                }
                else if (HasStoredPassword)
                {
                    <div class="form-hint text-success">
                        <i class="ti ti-lock me-1"></i>@T("Mot de passe enregistré et lisible.")
                    </div>
                }
                else
                {
                    <div class="form-hint text-warning">
                        <i class="ti ti-alert-triangle me-1"></i>
                        @T("Aucun mot de passe enregistré : la connexion à l'annuaire restera anonyme, ce qu'Active Directory refuse.")
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AuthLdapServer Server { get; set; } = null!;

    [Parameter]
    public bool HasStoredPassword { get; set; }

    /// <summary>Un secret est stocké mais ne se déchiffre plus — voir AuthSecretProtector.Unprotect.</summary>
    [Parameter]
    public bool StoredPasswordUnreadable { get; set; }

    [Parameter]
    public string BindPasswordPlain { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> BindPasswordPlainChanged { get; set; }

    // Server est muté directement (référence partagée avec le parent) : ça ne déclenche pas le
    // re-rendu du parent tout seul, d'où ce callback (même principe que GroupFormFields/ProfileFormFields).
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();

    private async Task OnPasswordInput(ChangeEventArgs e)
    {
        BindPasswordPlain = e.Value?.ToString() ?? string.Empty;
        await BindPasswordPlainChanged.InvokeAsync(BindPasswordPlain);
    }

    private RenderFragment YesNoSelect(bool value, Action<bool> setter) =>
        @<select class="form-select" value="@(value ? "true" : "false")" @onchange="@(e => setter(e.Value?.ToString() == "true"))">
            <option value="false">Non</option>
            <option value="true">Oui</option>
        </select>;
}
