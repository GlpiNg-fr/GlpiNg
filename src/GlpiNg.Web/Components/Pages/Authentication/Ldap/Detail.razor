@page "/config/auth/ldap/{ServerId:int}"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>GlpiNg — @(_server?.Name ?? "Annuaire LDAP")</PageTitle>

<AuthTabStrip Current="ldap" />

@if (_server is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-address-book fs-1"></i>
        <p class="mt-2">Cet annuaire est introuvable.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <i class="ti ti-address-book me-2"></i>
            <span class="fw-semibold">Annuaire LDAP - @_server.Name - ID @_server.Id</span>
        </div>
        <div class="card-body">
            <EditForm Model="_server" OnValidSubmit="SaveAsync">
                <LdapServerFormFields Server="_server" HasStoredPassword="@(_server.BindPasswordProtected is not null)"
                                       @bind-BindPasswordPlain="_bindPasswordPlain" />

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isTesting" @onclick="TestConnectionAsync">
                        <i class="ti ti-plug-connected me-1"></i>@(_isTesting ? "Test en cours…" : "Tester la connexion")
                    </button>
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                        <i class="ti ti-trash me-1"></i>Supprimer définitivement
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                        <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
