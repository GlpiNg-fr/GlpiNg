<div class="card mb-3">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" style="border-bottom: none;">
            <li class="nav-item">
                <a href="/config/notifications" class="nav-link @(Current == "config" ? "active" : "")">
                    <i class="ti ti-settings me-1"></i>@T("Configuration")
                </a>
            </li>
            <li class="nav-item">
                <a href="/config/notifications/templates" class="nav-link @(Current == "templates" ? "active" : "")">
                    <i class="ti ti-file-text me-1"></i>@T("Gabarits")
                </a>
            </li>
            <li class="nav-item">
                <a href="/config/notifications/rules" class="nav-link @(Current == "rules" ? "active" : "")">
                    <i class="ti ti-bell-ringing me-1"></i>@T("Notifications")
                </a>
            </li>
            <li class="nav-item">
                <a href="/config/notifications/queue" class="nav-link @(Current == "queue" ? "active" : "")">
                    <i class="ti ti-list-details me-1"></i>@T("File d'attente")
                </a>
            </li>
        </ul>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Current { get; set; } = string.Empty;
}
