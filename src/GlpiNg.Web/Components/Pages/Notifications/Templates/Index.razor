@page "/config/notifications/templates"
@using GlpiNg.Web.Models.Notifications
@rendermode InteractiveServer

<PageTitle>GlpiNg — Gabarits de notifications</PageTitle>

<NotificationsTabStrip Current="templates" />

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>Rechercher
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Rechercher un gabarit..."
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <label class="form-check m-0 px-2" title="Tout sélectionner">
                <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                       @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
            </label>

            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count gabarit(s) sélectionné(s) ? Cette action est définitive.</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="OnRefreshAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newTemplateModal">
                <i class="ti ti-plus me-1"></i>Ajouter
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;"></th>
                    <th>Nom</th>
                    <th>Type</th>
                    <th>Sujet</th>
                </tr>
            </thead>
            <tbody>
                @if (_filteredTemplates.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">Aucun gabarit configuré.</td>
                    </tr>
                }
                else
                {
                    @foreach (NotificationTemplate template in _filteredTemplates)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(template.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(template.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/config/notifications/templates/{template.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-file-text me-1 text-secondary"></i>@template.Name
                                </a>
                            </td>
                            <td>@NotificationEventCatalog.ItemTypeLabel(template.ItemType)</td>
                            <td>@template.Subject</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newTemplateModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-file-text me-2"></i>Nouvel élément - Gabarit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <TemplateFormFields Template="_newTemplate" OnChanged="StateHasChanged" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@(!CanCreate)" @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>Ajouter
                </button>
            </div>
        </div>
    </div>
</div>
