@using GlpiNg.Web.Models.Notifications

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom")</label>
            <input class="form-control" @bind="Template.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Type d'objet")</label>
            <select class="form-select" value="@Template.ItemType" @onchange="OnItemTypeChanged">
                @foreach ((string itemType, string label) in NotificationEventCatalog.ItemTypes)
                {
                    <option value="@itemType">@T(label)</option>
                }
            </select>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <textarea class="form-control" rows="2" @bind="Template.Comment"></textarea>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Balises disponibles")</label>
            <div class="glping-config-placeholder text-start p-2">
                @foreach (NotificationTag tag in AvailableTags)
                {
                    <div><code>##@tag.Key##</code> — @T(tag.Label)</div>
                }
                @if (AvailableTags.Count == 0)
                {
                    <span class="text-secondary">@T("Aucune balise pour ce type d'objet.")</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Sujet")</label>
            <input class="form-control" @bind="Template.Subject" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Corps texte du mail")</label>
            <textarea class="form-control" rows="6" @bind="Template.ContentText"></textarea>
        </div>
        <div class="glping-fiche-field">
            <label>@T("Corps HTML du mail (optionnel)")</label>
            <textarea class="form-control" rows="6" @bind="Template.ContentHtml"></textarea>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public NotificationTemplate Template { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private IReadOnlyList<NotificationTag> AvailableTags =>
        NotificationEventCatalog.EventsFor(Template.ItemType).FirstOrDefault()?.Tags ?? [];

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();

    private async Task OnItemTypeChanged(ChangeEventArgs e)
    {
        Template.ItemType = e.Value?.ToString() ?? Template.ItemType;
        await NotifyChangedAsync();
    }
}
