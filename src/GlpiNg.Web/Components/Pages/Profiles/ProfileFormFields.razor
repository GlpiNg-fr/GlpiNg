@using GlpiNg.Web.Models

<div class="row">
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Nom")</label>
            <input class="form-control" @bind="Profile.Name" @bind:event="oninput" @bind:after="NotifyChangedAsync" />
        </div>
        <div class="glping-fiche-field">
            <label>@T("Profil par défaut pour les nouveaux comptes")</label>
            <select class="form-select" value="@(Profile.IsDefault ? "true" : "false")" @onchange="@(e => Profile.IsDefault = e.Value?.ToString() == "true")">
                <option value="false">@T("Non")</option>
                <option value="true">@T("Oui")</option>
            </select>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glping-fiche-field">
            <label>@T("Commentaires")</label>
            <textarea class="form-control" rows="4" @bind="Profile.Comment"></textarea>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public GlpiProfile Profile { get; set; } = null!;

    // Profile est muté directement (référence partagée avec le parent) : ça ne déclenche pas
    // le re-rendu du parent tout seul, d'où ce callback pour les cas où le parent affiche un
    // état dérivé de Profile (ex. le bouton "Ajouter" désactivé tant que Name est vide).
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task NotifyChangedAsync() => OnChanged.InvokeAsync();
}
