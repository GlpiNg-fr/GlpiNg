@page "/admin/profiles/{ProfileId:int}"
@using GlpiNg.Web.Models
@rendermode InteractiveServer

<PageTitle>@(_profile?.Name ?? "Profil") — GlpiNg</PageTitle>

@if (_profile is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-id-badge fs-1"></i>
        <p class="mt-2">Ce profil est introuvable.</p>
    </div>
}
else
{
    <div class="glpi-fiche-topbar">
        <div class="glpi-fiche-crumb">
            <i class="ti ti-id-badge"></i>
            <span>Profil - @_profile.Name - ID @_profile.Id</span>
            <button type="button" class="glpi-fiche-favorite" title="Ajouter aux favoris">
                <i class="ti ti-star"></i>
            </button>
        </div>
        <div class="glpi-fiche-toolbar">
            @if (_total > 0)
            {
                <span class="glpi-fiche-pager-count">@_position/@_total</span>
                <a class="glpi-fiche-pager-btn @(_previousId is null ? "disabled" : "")" href="@(_previousId is { } prevId ? $"/admin/profiles/{prevId}" : "#")">
                    <i class="ti ti-chevron-left"></i>
                </a>
                <a class="glpi-fiche-pager-btn @(_nextId is null ? "disabled" : "")" href="@(_nextId is { } nextId ? $"/admin/profiles/{nextId}" : "#")">
                    <i class="ti ti-chevron-right"></i>
                </a>
            }
        </div>
    </div>

    <div class="glpi-fiche-layout">
        <aside class="glpi-fiche-sidebar">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="glpi-fiche-tab-item @(_activeTabKey == tab.Key ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                    <i class="ti @tab.Icon"></i>
                    <span>@tab.Label</span>
                    @if (tab.Count is { } count)
                    {
                        <span class="glpi-fiche-tab-count">@count</span>
                    }
                </button>
            }
        </aside>

        <div class="glpi-fiche-panel">
            @switch (_activeTabKey)
            {
                case "profil":
                    <EditForm Model="_profile" OnValidSubmit="SaveAsync">
                        <ProfileFormFields Profile="_profile" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                                <i class="ti ti-trash me-1"></i>Supprimer définitivement
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "droits":
                    <EditForm Model="_profile" OnValidSubmit="SaveAsync">
                        <div class="glpi-fiche-block-title"><i class="ti ti-lock"></i>Droits par section du menu</div>
                        <p class="text-secondary small">
                            Simplifié par rapport à GLPI : un seul droit par grande section du menu plutôt qu'une
                            matrice fine par module. <strong>Ces droits ne sont pas encore appliqués</strong> : GlpiNg
                            ne vérifie aujourd'hui aucune permission par page (seul <code>IsAdmin</code> existe sur
                            l'utilisateur, et il n'est lui-même vérifié nulle part).
                        </p>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Parc</label>
                                    <select class="form-select" @bind="_profile.ParcRight">
                                        <option value="@ProfileRightLevel.None">Aucun accès</option>
                                        <option value="@ProfileRightLevel.Read">Lecture</option>
                                        <option value="@ProfileRightLevel.Write">Lecture / Écriture</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Assistance</label>
                                    <select class="form-select" @bind="_profile.AssistanceRight">
                                        <option value="@ProfileRightLevel.None">Aucun accès</option>
                                        <option value="@ProfileRightLevel.Read">Lecture</option>
                                        <option value="@ProfileRightLevel.Write">Lecture / Écriture</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Gestion</label>
                                    <select class="form-select" @bind="_profile.GestionRight">
                                        <option value="@ProfileRightLevel.None">Aucun accès</option>
                                        <option value="@ProfileRightLevel.Read">Lecture</option>
                                        <option value="@ProfileRightLevel.Write">Lecture / Écriture</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glpi-fiche-field">
                                    <label>Outils</label>
                                    <select class="form-select" @bind="_profile.OutilsRight">
                                        <option value="@ProfileRightLevel.None">Aucun accès</option>
                                        <option value="@ProfileRightLevel.Read">Lecture</option>
                                        <option value="@ProfileRightLevel.Write">Lecture / Écriture</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Administration</label>
                                    <select class="form-select" @bind="_profile.AdministrationRight">
                                        <option value="@ProfileRightLevel.None">Aucun accès</option>
                                        <option value="@ProfileRightLevel.Read">Lecture</option>
                                        <option value="@ProfileRightLevel.Write">Lecture / Écriture</option>
                                    </select>
                                </div>
                                <div class="glpi-fiche-field">
                                    <label>Configuration</label>
                                    <select class="form-select" @bind="_profile.ConfigurationRight">
                                        <option value="@ProfileRightLevel.None">Aucun accès</option>
                                        <option value="@ProfileRightLevel.Read">Lecture</option>
                                        <option value="@ProfileRightLevel.Write">Lecture / Écriture</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
                            </button>
                        </div>
                    </EditForm>
                    break;

                case "utilisateurs":
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-plus"></i>Ajouter une habilitation</div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Entité</th>
                                        <th>Récursif</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <select class="form-select" @bind="_userIdToAssign">
                                                <option value="0">-- Choisir --</option>
                                                @foreach (GlpiUser user in _allUsers)
                                                {
                                                    <option value="@user.Id">@(user.DisplayName ?? user.UserName)</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select" @bind="_entityIdToAssign">
                                                <option value="0">-- Choisir --</option>
                                                @foreach (GlpiEntity entity in _allEntities)
                                                {
                                                    <option value="@entity.Id">@entity.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select" value="@(_isRecursiveToAssign ? "true" : "false")" @onchange="@(e => _isRecursiveToAssign = e.Value?.ToString() == "true")">
                                                <option value="false">Non</option>
                                                <option value="true">Oui</option>
                                            </select>
                                        </td>
                                        <td style="width: 8rem;">
                                            <button type="button" class="btn btn-primary w-100" disabled="@(_userIdToAssign == 0 || _entityIdToAssign == 0)" @onclick="AddHabilitationAsync">
                                                <i class="ti ti-plus me-1"></i>Ajouter
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="glpi-fiche-block-title mt-3"><i class="ti ti-user"></i>Utilisateurs (@_profileHabilitations.Count)</div>
                        @if (_profileHabilitations.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-user"></i>
                                <p class="mb-0">Aucune habilitation avec ce profil.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Utilisateur</th>
                                            <th>Entité</th>
                                            <th>Récursif</th>
                                            <th style="width: 6rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiUserProfile h in _profileHabilitations.OrderBy(h => h.User?.DisplayName ?? h.User?.UserName ?? string.Empty))
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"/admin/users/{h.UserId}")" class="text-reset">
                                                        <i class="ti ti-user me-1 text-secondary"></i>@(h.User?.DisplayName ?? h.User?.UserName ?? "Utilisateur inconnu")
                                                    </a>
                                                </td>
                                                <td>@(h.Entity?.Name ?? "Entité inconnue")</td>
                                                <td>@(h.IsRecursive ? "Oui" : "Non")</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Détacher" @onclick="() => RemoveHabilitationAsync(h.Id)">
                                                        <i class="ti ti-x"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "history":
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-history"></i>Historique (@_historyEntries.Count)</div>
                        @if (_historyEntries.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-history"></i>
                                <p class="mb-0">Aucun historique.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Utilisateur</th>
                                            <th>Champ</th>
                                            <th>Mise à jour</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (GlpiProfileHistoryEntry entry in Display.Chronological(_historyEntries, entry => entry.OccurredAt))
                                        {
                                            <tr>
                                                <td>@entry.Id</td>
                                                <td>@Display.DateTime(entry.OccurredAt)</td>
                                                <td>@entry.User</td>
                                                <td>@entry.Field</td>
                                                <td>@entry.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;

                case "all":
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-id-badge"></i>Profil</div>
                        <p class="mb-1"><strong>Nom :</strong> @_profile.Name</p>
                        <p class="mb-1"><strong>Par défaut :</strong> @YesNo(_profile.IsDefault)</p>
                        <p class="mb-0"><strong>Commentaires :</strong> @(_profile.Comment ?? "—")</p>
                    </div>
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-lock"></i>Droits</div>
                        <p class="mb-1"><strong>Parc :</strong> @RightLabel(_profile.ParcRight)</p>
                        <p class="mb-1"><strong>Assistance :</strong> @RightLabel(_profile.AssistanceRight)</p>
                        <p class="mb-1"><strong>Gestion :</strong> @RightLabel(_profile.GestionRight)</p>
                        <p class="mb-1"><strong>Outils :</strong> @RightLabel(_profile.OutilsRight)</p>
                        <p class="mb-1"><strong>Administration :</strong> @RightLabel(_profile.AdministrationRight)</p>
                        <p class="mb-0"><strong>Configuration :</strong> @RightLabel(_profile.ConfigurationRight)</p>
                    </div>
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-user"></i>Utilisateurs (@_profileHabilitations.Count)</div>
                        @foreach (GlpiUserProfile h in _profileHabilitations)
                        {
                            <p class="mb-1">@(h.User?.DisplayName ?? h.User?.UserName ?? "Utilisateur inconnu") — @(h.Entity?.Name ?? "Entité inconnue")</p>
                        }
                    </div>
                    <div class="glpi-fiche-block">
                        <div class="glpi-fiche-block-title"><i class="ti ti-history"></i>Historique (@_historyEntries.Count)</div>
                        @foreach (GlpiProfileHistoryEntry entry in Display.Chronological(_historyEntries, entry => entry.OccurredAt))
                        {
                            <p class="mb-1">@Display.DateTime(entry.OccurredAt) — @entry.User — @entry.Field : @entry.Description</p>
                        }
                    </div>
                    break;
            }
        </div>
    </div>
}
